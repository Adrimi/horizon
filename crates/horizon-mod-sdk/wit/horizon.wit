/// The contract between Horizon and its mods (docs/mods.md).
///
/// A mod is a WebAssembly component targeting the `mod` world. Each imported
/// interface but `log` is a capability: the mod's manifest lists the ones it
/// uses, the player sees them before turning the mod on, and the game refuses
/// a component that imports one its manifest does not declare.
package horizon:mods@0.1.15;

/// The mod's log, in the game's log under the mod's id. Always granted.
interface log {
    enum level {
        debug,
        info,
        warn,
        error,
    }
    write: func(level: level, message: string);
}

/// Capability `game-read`: the local player and the world clock.
interface game {
    record player {
        x: f64,
        y: f64,
        z: f64,
        /// Degrees, as F3 shows them.
        yaw: f32,
        pitch: f32,
        health: f32,
        food: u32,
        /// `minecraft:overworld`, `minecraft:the_nether`, ...
        dimension: string,
    }
    record clock {
        /// Ticks since the world was created.
        game-time: u64,
        /// 24000 ticks per day; 0 is 6:00 on the first day.
        day-time: u64,
    }
    /// None on the title screen.
    get-player: func() -> option<player>;
    get-clock: func() -> option<clock>;
    /// Hunger as `FoodData` keeps it (API 0.1.2).
    record food-stats {
        /// 0 to 20, as `player.food`.
        food: u32,
        /// 0 to `food`: what is spent before hunger drops.
        saturation: f32,
        /// 0 to 40; every 4 takes one saturation (or food) point.
        exhaustion: f32,
    }
    /// None on the title screen (API 0.1.2).
    get-food-stats: func() -> option<food-stats>;
    /// The world's seed; none when the game does not know it, as in
    /// another's world (API 0.1.7).
    get-seed: func() -> option<u64>;
    /// The field of view the game drew the last frame with, in degrees, the
    /// vertical one; none outside a world (API 0.1.7).
    get-fov: func() -> option<f32>;
    /// The world the player is in (API 0.1.10).
    record session {
        /// A number that changes with every world loaded and every server
        /// joined.
        id: u64,
        /// The milliseconds since that world was loaded.
        elapsed-ms: u64,
    }
    /// The world the player is in; none outside a world (API 0.1.10).
    get-session: func() -> option<session>;
    /// The player's health (API 0.1.11).
    record health {
        health: f32,
        /// The most health the player can have.
        max-health: f32,
        /// The absorption (the golden hearts).
        absorption: f32,
    }
    /// The player's health; none outside a world (API 0.1.11).
    get-health: func() -> option<health>;
    /// The ids of the effects on the player (`minecraft:poison`,
    /// `minecraft:regeneration`, ...); empty when there is none (API 0.1.11).
    get-effects: func() -> list<string>;
    /// The world's difficulty: `peaceful`, `easy`, `normal` or `hard`; none
    /// outside a world (API 0.1.11).
    get-difficulty: func() -> option<string>;
}

/// Capability `chat`: messages only the local player sees.
interface chat {
    /// Shown in chat after the mod's name, like a system message.
    show: func(text: string);
    /// The player who wrote a chat message (API 0.1.15).
    record sender {
        /// Their name; empty when the game does not know it (they are not
        /// in the player list).
        name: string,
        /// Their UUID as 32 hexadecimal characters, no hyphens.
        uuid: string,
    }
    /// A chat message the player received (API 0.1.15).
    record message {
        /// The message's number in this session: grows, never repeats.
        id: u64,
        /// Its text, without formatting, as the `chat` hook gets it.
        text: string,
        /// Who wrote it; none for a system message, `/say` and a message
        /// whose sender the server hid.
        sender: option<sender>,
    }
    /// The messages received since the last tick, oldest first, the same
    /// for every mod. The game adds a message to this list *before* it calls
    /// the `chat` hook, so a mod that reads it in the hook finds that
    /// message last (API 0.1.15).
    get-messages: func() -> list<message>;
}

/// Capability `chat-decorate`: a picture before a chat message and the room
/// the game leaves for it (API 0.1.15). The mod says once which picture a
/// message gets; the game draws it and indents the text, so no mod code
/// runs when the chat is drawn.
interface chat-decorate {
    /// Where a picture comes from.
    variant source {
        /// The skin of the player who wrote the message (64 by 64): the
        /// one the player list has downloaded, else the default skin for
        /// their UUID.
        sender-skin,
        /// The skin of the player with this UUID (32 hexadecimal
        /// characters), 64 by 64.
        player-skin(string),
        /// A sprite of the game's GUI atlas by name (`hud/heart/full`).
        sprite(string),
    }
    /// A rectangle of the source, in pixels.
    record region {
        x: u32,
        y: u32,
        width: u32,
        height: u32,
    }
    record picture {
        source: source,
        /// The rectangles to draw, one over the other in the same place
        /// (a face and its hat); empty draws the sprite whole. At most 8.
        regions: list<region>,
        /// The picture's size on screen, in GUI pixels (1 to 64).
        width: u32,
        height: u32,
    }
    /// The picture before the message with this id, or none for no picture.
    /// Set it in the `chat` hook, before the game adds the message to the
    /// chat; the picture then starts the message's first line and the text
    /// of all its lines is indented by `width + 2` pixels. The first mod to
    /// give a picture for a message wins.
    set-picture: func(id: u64, picture: option<picture>);
}

/// Capability `hud`: one panel of text lines per mod, drawn by the game
/// every frame until the mod changes or clears it (no call per frame).
interface hud {
    enum corner {
        top-left,
        top-right,
        bottom-left,
        bottom-right,
    }
    record line {
        text: string,
        /// 0xRRGGBB.
        color: u32,
    }
    set-panel: func(corner: corner, lines: list<line>);
    clear: func();
    /// One icon of a status bar as the game drew it (API 0.1.7).
    record bar-icon {
        /// The top left corner in GUI pixels, after the shaking of the bar.
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        /// The sprite the game drew (`hud/food_empty`, `hud/heart/container`,
        /// ...).
        name: string,
    }
    /// The health and hunger bars as the game drew them in the last frame.
    record bars {
        /// The container of each hunger icon, in the order the game drew
        /// them.
        food: list<bar-icon>,
        /// The container of each heart, in the order the game drew them.
        health: list<bar-icon>,
    }
    /// Where the bars are; none when the game draws none (creative,
    /// spectator, the HUD hidden). One frame old (API 0.1.7).
    get-bars: func() -> option<bars>;
}

/// Capability `target`: the block the player looks at, and the one they
/// are breaking (API 0.1.1).
interface target {
    record block {
        x: s32,
        y: s32,
        z: s32,
        /// `minecraft:stone`, ...
        id: string,
        /// Vanilla's destroy time; -1 for a block that cannot be broken.
        hardness: f32,
        /// Drops only when broken with the correct tool.
        requires-tool: bool,
        /// Every block tag it is in: `minecraft:mineable/pickaxe`,
        /// `minecraft:needs_iron_tool`, `minecraft:leaves`, ...
        tags: list<string>,
    }
    /// The block under the crosshair within reach; none on air, an entity
    /// or the title screen.
    get-block: func() -> option<block>;
    /// The block the player is breaking (the attack button held on it in
    /// survival or adventure), from its first tick to its last.
    get-breaking: func() -> option<block>;
    /// How far that block is broken, 0 to 1; none when none is (API 0.1.2).
    get-breaking-progress: func() -> option<f32>;
    /// The looked-at block's name in the game's language (`Block.getName`),
    /// its id when the language has none; none as `get-block` (API 0.1.2).
    get-block-name: func() -> option<string>;
    /// A living entity under the crosshair (API 0.1.2).
    record entity {
        /// Its id in the world this tick.
        id: u32,
        /// `minecraft:zombie`, ...
        type-id: string,
        /// Its custom name, else its type's name in the game's language.
        name: string,
        health: f32,
        max-health: f32,
    }
    /// The mob the attack button would hit (`EntityHitResult`) within
    /// reach, before any block; none otherwise (API 0.1.2).
    get-entity: func() -> option<entity>;
    /// The armour points of the mob under the crosshair
    /// (`LivingEntity.getArmorValue`: its type's, not what it wears); none
    /// as `get-entity` (API 0.1.9).
    get-entity-armor: func() -> option<f32>;
    /// The absorption of the mob under the crosshair; none as `get-entity`.
    /// The game does not track a mob's absorption: 0 (API 0.1.9).
    get-entity-absorption: func() -> option<f32>;
    /// The face of the block under the crosshair that the player looks at:
    /// `north`, `south`, `east`, `west`, `up` or `down`; none as `get-block`
    /// (API 0.1.9).
    get-block-face: func() -> option<string>;
}

/// Capability `inventory-read`: the player's hotbar (API 0.1.1).
interface inventory {
    record stack {
        /// `minecraft:iron_pickaxe`, ...
        id: string,
        count: u32,
        damage: u32,
        /// 0 for an item that does not wear out.
        max-damage: u32,
        /// Its Efficiency level, 0 without.
        efficiency: u32,
        /// How fast it breaks the targeted block (the one being broken,
        /// else the one looked at): `Tool.getMiningSpeed` plus Efficiency's
        /// `mining_efficiency`, as `Player.getDestroySpeed` adds it. 1 for a
        /// hand, or with no block targeted.
        mining-speed: f32,
        /// `Tool.isCorrectForDrops` for that block.
        correct-for-drops: bool,
    }
    /// Slots 0 to 8; none for an empty slot.
    get-hotbar: func() -> list<option<stack>>;
    /// The selected slot, 0 to 8.
    get-selected: func() -> u32;
    /// What eating a stack gives: its `minecraft:food` component (API 0.1.2).
    record food {
        nutrition: u32,
        /// Added to saturation, as `FoodData.eat` adds it.
        saturation: f32,
    }
    /// The food in hotbar slot 0 to 8; none for an empty slot, an item
    /// that is not food or another slot (API 0.1.2).
    get-food: func(slot: u32) -> option<food>;
    /// Every item tag `id` is in, as full names without `#`:
    /// `minecraft:axes`, `minecraft:pickaxes`, `minecraft:swords`, ...
    /// Nested tags are already expanded, as vanilla's `TagLoader` does.
    /// Empty for an unknown id (API 0.1.3).
    item-tags: func(id: string) -> list<string>;
    /// Every item tag the item in hotbar slot 0 to 8 is in (API 0.1.3);
    /// empty for an empty slot, another slot or an unknown item.
    get-tags: func(slot: u8) -> list<string>;
    /// A stack with everything that tells it apart from another one (API
    /// 0.1.10).
    record item-stack {
        /// `minecraft:iron_pickaxe`, ...
        id: string,
        count: u32,
        /// The durability used; 0 for an item that does not wear out.
        damage: u32,
        /// The item's other components (enchantments, a custom name, a
        /// potion's contents, a trim, a container's items): opaque text, the
        /// same for stacks that are the same thing, empty for a plain stack.
        components: string,
    }
    /// The player's whole inventory.
    record player-inventory {
        /// The 36 slots: the hotbar (0 to 8) and the rest (9 to 35).
        slots: list<option<item-stack>>,
        /// The armour: head, chest, legs, feet.
        armour: list<option<item-stack>>,
        /// The off hand.
        offhand: option<item-stack>,
        /// The stack on the cursor.
        carried: option<item-stack>,
    }
    /// A crafting grid and what it makes.
    record crafting {
        /// The grid's cells in row order: 4 for the player's 2x2, 9 for a
        /// crafting table's 3x3.
        grid: list<option<item-stack>>,
        /// What the grid makes; none when it makes nothing.
        output: option<item-stack>,
    }
    /// The player's whole inventory; none outside a world (API 0.1.10).
    get-inventory: func() -> option<player-inventory>;
    /// The crafting grid and its result while the player's inventory or a
    /// crafting table is open; none otherwise (API 0.1.10).
    get-crafting: func() -> option<crafting>;
    /// Capability `inventory-edit` (API 0.1.5): gives the player `count` of
    /// the item `id`, as the creative inventory does: the stack goes into
    /// the inventory, and what does not fit is dropped. False (and nothing
    /// happens) without the capability, for an unknown id, a count of 0,
    /// when the player is not in creative, or in a world another game runs.
    give: func(id: string, count: u32) -> bool;
    /// What eating the item with that id gives (`minecraft:cooked_beef`, ...);
    /// none when it is not food (API 0.1.11).
    get-food-of: func(id: string) -> option<food>;
    /// Whether eating the item can hurt: one of its effects is Hunger
    /// (rotten flesh, a pufferfish, raw chicken); the game draws such food
    /// with the "hunger" icons (API 0.1.11).
    get-harmful-food: func(id: string) -> bool;
    /// The stack in the off hand; none when it is empty (API 0.1.11).
    get-offhand: func() -> option<stack>;
}

/// Capability `hotbar`: changing the selected slot, as the number keys do
/// (API 0.1.1).
interface hotbar {
    /// Selects slot 0 to 8 before the game's next tick; other values are
    /// ignored. The last call in a tick wins.
    select: func(slot: u32);
}

/// Capability `keys`: the mod's own key bindings, shown in Controls
/// (API 0.1.4). The mod names its actions; the player rebinds them.
interface keys {
    /// A key event since the last `poll`.
    record key-event {
        /// The mod's action (`map`, `waypoint`, ...), as it was bound.
        action: string,
        /// Pressed (true) or released (false).
        pressed: bool,
        /// The key repeats itself while it is held.
        repeat: bool,
    }
    /// Binds the mod's `action` to a key (`key.keyboard.m`); the player may
    /// rebind it in Controls. Binding an action twice replaces the old key.
    bind: func(action: string, default-key: string) -> result<_, string>;
    /// The key bound to the mod's `action` now (`key.keyboard.m`); none when
    /// the action is not bound or unbound by the player.
    get: func(action: string) -> option<string>;
    /// The key events since the last call; empty when nothing happened.
    poll: func() -> list<key-event>;
    /// Whether the key is held down now (`key.keyboard.left.shift`, ...): the
    /// names are the game's, as in `bind` and `options.txt`. Cheap enough
    /// to ask every frame (API 0.1.11).
    is-down: func(key: string) -> bool;
}

/// Capability `storage`: a per-mod folder of small key/value files, quota'd
/// (docs/mods.md). Keys are `[a-z0-9_.-]{1,64}`, one path segment. The folder
/// is `.horizon-mod-data/<id>` in the folder the mod is loaded from; a mod
/// that needs more than the default 4 MiB / 64 keys asks for it in its
/// manifest (`storage_quota_mib`, `storage_max_keys`). It is there in `init`.
interface storage {
    /// None if `key` has never been `set`, or the key is not well-formed.
    get: func(key: string) -> option<list<u8>>;
    /// Errs on a malformed key or over quota (bytes for the whole mod).
    set: func(key: string, value: list<u8>) -> result<_, string>;
    /// No error if `key` was already absent.
    delete: func(key: string);
    /// The mod's keys, sorted (API 0.1.5).
    list-keys: func() -> list<string>;
    /// Deprecated, API 0.1.4's name of `get`.
    read: func(name: string) -> option<list<u8>>;
    /// Deprecated, API 0.1.4's name of `set`.
    write: func(name: string, data: list<u8>) -> result<_, string>;
    /// Deprecated, API 0.1.4's name of `delete`; true when it was there.
    remove: func(name: string) -> bool;
    /// Deprecated, API 0.1.4's name of `list-keys`.
    files: func() -> list<string>;
}

/// Capability `screen`: a screen the mod draws and handles itself
/// (API 0.1.4). The game draws it over the world, without the mouse
/// grabbed, and gives it the player's input while it is open.
interface screen {
    /// The screen's size in GUI pixels.
    record size {
        width: f32,
        height: f32,
    }
    /// What to draw.
    variant shape {
        /// A filled rectangle.
        rect(rect-shape),
        /// A line of text.
        text(text-shape),
        /// An uploaded image, scaled into the rectangle.
        image(image-shape),
    }
    /// A filled rectangle.
    record rect-shape {
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        /// 0xRRGGBB.
        color: u32,
    }
    /// A line of text; (x, y) is its top left corner.
    record text-shape {
        x: f32,
        y: f32,
        text: string,
        /// 0xRRGGBB.
        color: u32,
        /// The text's shadow.
        shadow: bool,
    }
    /// An uploaded image, scaled into the rectangle.
    record image-shape {
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        /// The image's id, from `upload-texture`.
        texture: u32,
    }
    /// What the player did while the screen was open.
    variant event {
        /// A key.
        key(key-press),
        /// The mouse moved.
        mouse-move(mouse-move),
        /// A mouse button.
        mouse-button(mouse-press),
        /// The wheel.
        wheel(wheel-turn),
        /// The screen was closed.
        closed,
    }
    /// A key; `text` is the character it typed.
    record key-press {
        /// The key's name, as the game's (`key.keyboard.m`).
        key: string,
        /// Pressed (true) or released (false).
        pressed: bool,
        /// The character the key typed, when it typed one.
        text: option<string>,
    }
    /// The mouse moved; the place is in GUI pixels.
    record mouse-move {
        x: f32,
        y: f32,
    }
    /// A mouse button: 0 left, 1 right, 2 middle.
    record mouse-press {
        button: u32,
        /// Pressed (true) or released (false).
        pressed: bool,
        x: f32,
        y: f32,
    }
    /// The wheel; positive is up.
    record wheel-turn {
        steps: f32,
        x: f32,
        y: f32,
    }
    /// A point in GUI pixels (API 0.1.5).
    record point {
        x: f32,
        y: f32,
    }
    /// A rectangle in GUI pixels (API 0.1.5).
    record area {
        x: f32,
        y: f32,
        width: f32,
        height: f32,
    }
    /// The modifier keys held now (API 0.1.5).
    record modifiers {
        shift: bool,
        ctrl: bool,
        alt: bool,
    }
    /// The screen of the game itself that is open (API 0.1.5).
    enum game-screen {
        /// None: the world is being played.
        none,
        /// The player's inventory, with its 2x2 crafting grid.
        inventory,
        /// A crafting table.
        crafting,
        /// A container: a chest, a barrel, a furnace, a brewing stand, a
        /// crafter, a hopper, a dispenser.
        container,
        /// A workstation: an enchanting table, an anvil, a grindstone, a
        /// smithing table, a stonecutter, a beacon, a cartography table, a
        /// loom, a villager's trades.
        station,
        /// A mount's inventory (a horse, a donkey, a llama).
        mount,
        /// The creative inventory.
        creative,
        /// The chat.
        chat,
        /// The options.
        options,
        /// Every other screen of the game.
        other,
    }
    /// A line of a tooltip.
    record tip-line {
        text: string,
        /// 0xAARRGGBB.
        color: u32,
    }
    /// What to paint (API 0.1.5): everything `shape` draws and what a port
    /// of a Java mod's interface needs. Colours are 0xAARRGGBB.
    variant element {
        /// A rectangle, flat or a vertical gradient.
        fill(fill-element),
        /// A line of text.
        label(label-element),
        /// A sprite of the game's GUI atlas (a heart, a hunger shank, a
        /// button, an icon of the game's own), stretched into a rectangle.
        sprite(sprite-element),
        /// A part of an uploaded image.
        picture(picture-element),
        /// An item's icon, with its count and durability bar, as the
        /// inventory draws it.
        item(item-element),
        /// The game's own tooltip of an item.
        tooltip(tooltip-element),
        /// A tooltip box of the mod's own lines.
        tip(tip-element),
    }
    /// A rectangle; `top` and `bottom` are the colours of its top and
    /// bottom edges (equal: flat).
    record fill-element {
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        top: u32,
        bottom: u32,
    }
    /// A line of text; (x, y) is its top left corner.
    record label-element {
        x: f32,
        y: f32,
        text: string,
        /// 0xAARRGGBB.
        color: u32,
        shadow: bool,
        /// 1.0 is the game's size; the text grows from (x, y).
        scale: f32,
    }
    /// A sprite of the game's atlas by name: the texture's path under
    /// `assets/minecraft/textures/` without `.png` (`gui/sprites/hud/heart/full`,
    /// `gui/sprites/container/slot`, `item/apple`, ...). It is stretched
    /// into the rectangle (no nine-slice). An unknown name draws nothing.
    record sprite-element {
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        name: string,
        /// Multiplies the sprite's colour: 0xFFFFFFFF leaves it as it is,
        /// the alpha makes it translucent (the blinking of a bar).
        tint: u32,
    }
    /// A part of an image from `upload-texture` (in the full screen), in
    /// the image's own pixels, drawn into the rectangle.
    record picture-element {
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        texture: u32,
        u: f32,
        v: f32,
        u-width: f32,
        v-height: f32,
        tint: u32,
    }
    /// An item's icon (16 by 16 GUI pixels) at (x, y).
    record item-element {
        x: f32,
        y: f32,
        /// `minecraft:oak_planks`, ...; an unknown id draws nothing.
        id: string,
        /// Drawn in the corner when above 1.
        count: u32,
    }
    /// The game's own tooltip of an item, as the inventory shows it (name,
    /// stats, modifiers), its corner at (x, y), kept inside the screen;
    /// `extra` are the lines under it.
    record tooltip-element {
        x: f32,
        y: f32,
        id: string,
        count: u32,
        extra: list<tip-line>,
    }
    /// A tooltip box of lines, its corner at (x, y), kept inside the screen.
    record tip-element {
        x: f32,
        y: f32,
        lines: list<tip-line>,
    }
    /// What to paint in the next frame (API 0.1.5), after what `draw`
    /// gave; the elements of the last frame stay until the mod paints
    /// again.
    paint: func(id: u32, elements: list<element>);
    /// The width of the text in GUI pixels at the game's font (API 0.1.5);
    /// letters the game's bitmap fonts do not have count as 8.
    get-text-width: func(text: string) -> f32;
    /// Opens a panel over the game's own screen (API 0.1.5): the
    /// inventory, a container, a crafting table. The game keeps drawing
    /// and running that screen; the panel is painted over it, and the
    /// mouse is the mod's inside `area`, the game's outside. A panel is
    /// not the mod's screen: a mod may have both. It is painted only while
    /// the game has the inventory, a container, a crafting table or a
    /// station open. `keys` are the keys the mod takes instead of the game
    /// (`key.keyboard.r`, ...); `*` is every key. The mod reads the panel's
    /// input with `get-input`, like the screen's.
    open-panel: func(title: string, area: area, keys: list<string>) -> result<u32, string>;
    /// Moves or resizes the panel and changes its keys. An area of width
    /// or height 0 hides the panel.
    set-panel-area: func(id: u32, area: area, keys: list<string>);
    /// Which screen of the game is open (API 0.1.5).
    get-game-screen: func() -> game-screen;
    /// The top left corner of the open screen's menu (the inventory's,
    /// the container's), in GUI pixels; none when there is no menu
    /// (API 0.1.5).
    get-menu-origin: func() -> option<point>;
    /// The item in the slot of the open screen under that point, none over
    /// no slot or an empty one (API 0.1.5).
    get-item-at: func(x: f32, y: f32) -> option<string>;
    /// Where the mouse is now, in GUI pixels (API 0.1.5).
    get-cursor: func() -> point;
    /// The modifier keys held now (API 0.1.5).
    get-modifiers: func() -> modifiers;
    /// Opens the mod's screen and returns its id; the title is shown above
    /// it. A mod has one screen: opening another closes the first.
    open: func(title: string) -> result<u32, string>;
    /// The screen's size in GUI pixels; none when it is closed.
    get-size: func(id: u32) -> option<size>;
    /// What to draw in the next frame; the shapes of the last frame stay
    /// until the mod draws again.
    draw: func(id: u32, shapes: list<shape>);
    /// What the player did since the last call; empty when nothing
    /// happened. A closed screen keeps its last events, so the mod can read
    /// the `closed` one.
    get-input: func(id: u32) -> list<event>;
    /// Closes the screen; the mod gets the `closed` event.
    close: func(id: u32);
    /// Uploads an RGBA image (`width * height * 4` bytes) under the id
    /// `id` (0 to 7); the mod draws it with an `image` shape. Uploading
    /// under the same id again replaces the image. At most 8 images of
    /// 256x256 pixels each.
    upload-texture: func(id: u32, width: u32, height: u32, rgba: list<u8>) -> result<_, string>;
}

/// Capability `world-read`: blocks of the loaded world by position, and the
/// ones broken since the last tick (API 0.1.2). With capability
/// `world-edit` as well, breaking blocks and wearing the held item, in a
/// world this game runs (single player, or one it opened to LAN); in
/// another's world the edits do nothing and return false or none.
interface %world {
    record block-pos {
        x: s32,
        y: s32,
        z: s32,
    }
    record world-block {
        pos: block-pos,
        /// `minecraft:oak_log`, ...
        id: string,
        /// The state's properties: `axis`=`y`, `distance`=`7`,
        /// `persistent`=`false`, ...
        properties: list<tuple<string, string>>,
        /// Every block tag it is in: `minecraft:logs`, `minecraft:leaves`, ...
        tags: list<string>,
    }
    record block-broken {
        pos: block-pos,
        /// The block as it was before it broke.
        block: world-block,
        /// Broken by the player's hand or tool; false for a block a mod
        /// broke.
        by-player: bool,
        /// What the player broke it with (`minecraft:iron_axe`, ...); none
        /// for a bare hand or a block a mod broke.
        tool: option<string>,
        /// The player was sneaking as they broke it.
        sneaking: bool,
    }
    /// The block at `pos`; none where no chunk is loaded (and outside a
    /// world). Air is `minecraft:air`.
    get-block: func(pos: block-pos) -> option<world-block>;
    /// A block that got a random tick (API 0.1.12).
    record random-tick {
        pos: block-pos,
        /// The block as it is now.
        block: world-block,
    }
    /// The blocks in the watched tags that got a random tick since the
    /// previous tick, oldest first: the same positions the client's ambient
    /// effects use (667 within 16 and 32 blocks of the player,
    /// `ClientLevel.animateTick`), at most 2048 a tick. Empty until
    /// `watch-random-ticks` is called (API 0.1.12).
    random-ticked-blocks: func() -> list<random-tick>;
    /// Watches the blocks of these tags (`minecraft:leaves`): only they are
    /// reported by `random-ticked-blocks`. Calling it again replaces the
    /// earlier tags; an empty list stops the listening. Works in `init`
    /// too (API 0.1.12).
    watch-random-ticks: func(tags: list<string>);
    /// The blocks broken since the previous tick, oldest first: the
    /// player's and those mods broke. The same list for every mod, read
    /// during `tick`.
    broken-blocks: func() -> list<block-broken>;
    /// `world-edit`: breaks the block as `Level.destroyBlock` does (its
    /// particles and sound), with its drops (its loot table without a tool)
    /// when `drops`. True when a breakable block was there. The block
    /// breaks after the call returns: until then `get-block` still sees it.
    break-block: func(pos: block-pos, drops: bool) -> bool;
    /// `world-edit`: as `break-block` with drops, the loot rolled with the
    /// item in the player's hand (Fortune, Silk Touch, the correct tool),
    /// which is not worn by it.
    break-block-with-held: func(pos: block-pos) -> bool;
    /// `world-edit`: wears the item in the player's main hand by `amount`
    /// uses (Unbreaking may spare some, as in vanilla); it may break. The
    /// durability left after the full `amount`, none when the hand holds
    /// nothing that wears or the player is in creative.
    damage-held: func(amount: u32) -> option<u32>;
    /// The surface of one chunk: what a map shows of its columns
    /// (API 0.1.4). The lists hold 256 values, in the order `z * 16 + x`.
    record chunk-surface {
        /// Each column's map colour (`MapColor`, 0 = none), as in
        /// `get-map-colors`.
        color: list<u8>,
        /// Each column's height: the Y of the topmost coloured block.
        y: list<s32>,
        /// Each column's water (or lava) depth over the surface.
        depth: list<u8>,
        /// Each column's biome, as an index in `get-biome-names`.
        biome: list<u16>,
    }
    /// The surface of the loaded chunk (cx, cz); none when the chunk is not
    /// loaded. The scan is the game's, as the minimap's is.
    get-chunk-surface: func(cx: s32, cz: s32) -> option<chunk-surface>;
    /// The world's biome names, in the order of their indexes (the ones
    /// `get-chunk-surface` gives); empty outside a world.
    get-biome-names: func() -> list<string>;
    /// The colours of the map (`MapColor`) by id, as 0xRRGGBB; the id is
    /// the one `get-chunk-surface` gives. Empty outside a world.
    get-map-colors: func() -> list<u32>;
    /// As `get-chunk-surface`, but the scan goes down from the height `y`
    /// instead of the top of the chunk: the highest block with a map colour
    /// at `y` or below, for a cave map (API 0.1.7).
    get-chunk-columns: func(cx: s32, cz: s32, y: s32) -> option<chunk-surface>;
    /// A biome as a mod reads it (API 0.1.6).
    record biome {
        /// `minecraft:desert`, ...
        id: string,
        /// `Biome.getBaseTemperature`.
        temperature: f32,
        /// `Biome.hasPrecipitation`: it gets rain or snow at all.
        precipitation: bool,
        /// How much precipitation falls in it (`downfall`).
        downfall: f32,
        /// The foliage colour 0xRRGGBB (`FoliageColor`), the grass colour
        /// (`GrassColor`, before a grass modifier) and the water colour.
        foliage: u32,
        grass: u32,
        water: u32,
    }
    /// The biome at `pos`; none where no chunk is loaded (API 0.1.6).
    get-biome: func(pos: block-pos) -> option<biome>;
    /// Where the ground is in the column of `pos`: the y of the first free
    /// space above the first block that stops motion (solid, leaves or a
    /// fluid) found going down from `start-y` (`Heightmap.MOTION_BLOCKING`'s
    /// idea); none where no chunk is loaded (API 0.1.6).
    get-surface: func(pos: block-pos, start-y: s32) -> option<s32>;
    /// Whether the block at `pos` has a full collision box (API 0.1.6).
    is-solid: func(pos: block-pos) -> bool;
    /// One stack in a container (API 0.1.9).
    record container-stack {
        /// `minecraft:stone`, ...
        id: string,
        count: u32,
        /// The durability used; 0 for an item that does not wear out.
        damage: u32,
    }
    /// The items of the container at `pos` (a chest, a barrel, a shulker box,
    /// a hopper, a dropper, a dispenser, a crafter; a furnace, a blast
    /// furnace or a smoker: input, fuel, result), in slot order, an empty slot
    /// none. Only for the block the player looks at or is breaking, in a
    /// world this game runs or whose contents the game knows; none for any
    /// other position or block (API 0.1.9).
    get-container: func(pos: block-pos) -> option<list<option<container-stack>>>;
}

/// Capability `items-read`: the items of the game, vanilla's and the content
/// mods' (API 0.1.5).
interface items {
    record item {
        /// `minecraft:oak_planks`, ...
        id: string,
        /// Its name in the game's language; the id when it has none.
        name: string,
        /// The stack size: 64 for most items, 1 for tools and armour.
        max-stack: u32,
        /// Every tag it is in, as full names without `#`.
        tags: list<string>,
    }
    /// Every item of the game, in the order of the creative inventory's
    /// search tab.
    %list: func() -> list<item>;
    /// One item by id; none for an unknown id.
    get: func(id: string) -> option<item>;
}

/// Capability `recipes-read`: the recipes of the game, vanilla's and the
/// content mods' (API 0.1.5). The recipes that run code (dyeing, copying a
/// map) have no fixed slots and are not listed.
interface recipes {
    enum kind {
        crafting-shaped,
        crafting-shapeless,
        smelting,
        blasting,
        smoking,
        campfire-cooking,
        stonecutting,
        smithing-transform,
        smithing-trim,
    }
    record recipe {
        kind: kind,
        /// The block it is made at, as an item id: `minecraft:crafting_table`,
        /// `minecraft:furnace`, ...
        station: string,
        /// The slots that take items, one list per slot: the items it
        /// accepts (one item, or the items of a tag or a list). A crafting
        /// recipe's are the grid's cells in row order, the empty ones as
        /// empty lists (shapeless: 2 wide for up to 4 ingredients, else 3
        /// wide); cooking and stonecutting have one slot, smithing three
        /// (template, base, addition).
        inputs: list<list<string>>,
        /// The item made (the recipe's result); none for a trim, which keeps
        /// its base.
        output: option<string>,
        /// How many of the result it makes.
        count: u32,
        /// A crafting recipe's grid; 0 for the other kinds.
        width: u32,
        height: u32,
        /// A cooking recipe's time in ticks and the experience it gives.
        time: u32,
        experience: f32,
    }
    /// Every recipe of the game.
    %list: func() -> list<recipe>;
}

/// Capability `weather-read`: the weather over the player (API 0.1.6).
interface weather {
    record state {
        /// 0 to 1: how hard it rains (`Level.getRainLevel`).
        rain: f32,
        /// 0 to 1: how hard the thunderstorm is (`Level.getThunderLevel`).
        thunder: f32,
    }
    /// The weather over the player; none outside a world and in a dimension
    /// that has none.
    get-weather: func() -> option<state>;
}

/// Capability `settings-read`: the client's own settings (API 0.1.6).
interface settings {
    /// The Particles setting: 0 all, 1 decreased, 2 minimal.
    get-particles: func() -> u32;
}

/// Capability `particles`: the mod's own particles with its own pictures
/// (API 0.1.6).
interface particles {
    /// A picture the mod's particles are drawn with.
    record sprite {
        /// The mod's own name for it (`rain_drop`); the same name replaces
        /// the old picture.
        name: string,
        /// 1 to 64 pixels.
        width: u32,
        height: u32,
        /// RGBA, four bytes a pixel, row by row from the top left.
        pixels: list<u8>,
    }
    /// A colour, each part 0 to 1; white leaves the picture's own colours.
    record color {
        r: f32,
        g: f32,
        b: f32,
        a: f32,
    }
    /// How the particle's size changes as it lives.
    enum size-curve {
        /// The same size the whole time.
        constant,
        /// Grows from a third of its size to its size.
        grow,
        /// Shrinks to nothing.
        shrink,
    }
    /// How the particle fades out.
    enum fade {
        /// It stays as bright as it is.
        none,
        /// It fades at the end of its life, as vanilla's particles do.
        late,
        /// It fades over its whole life.
        full,
    }
    /// One particle.
    record options {
        /// The picture (the number `define-sprite` gave).
        sprite: u32,
        /// Where it starts, in blocks.
        x: f64,
        y: f64,
        z: f64,
        /// How fast it moves at the start, in blocks per tick.
        vx: f64,
        vy: f64,
        vz: f64,
        color: color,
        /// The width of its quad, in blocks.
        size: f32,
        /// How long it lives, in ticks (1 to 1200).
        lifetime: u32,
        /// The downward speed it gains every tick.
        gravity: f32,
        /// The sideways speed (x and z, blocks per tick) it is pulled
        /// towards: the wind. 0 and 0 leaves its own.
        wind-x: f64,
        wind-z: f64,
        /// Whether it stops at the blocks and fluids it hits (and is then
        /// reported by `landed`).
        collide: bool,
        size-curve: size-curve,
        fade: fade,
        /// Whether it lies flat (a ring on the water).
        flat: bool,
        /// How many ticks it lies where it landed before it vanishes.
        linger: u32,
        /// How far it sways sideways, in blocks per tick at most (0: no
        /// sway), and how many ticks a sway takes (at least 1).
        sway: f32,
        sway-period: u32,
        /// How fast it turns about its own axis and about a horizontal one,
        /// in radians per tick.
        spin: f32,
        tumble: f32,
    }
    /// Where one of the mod's colliding particles landed.
    record landing {
        /// The picture of the particle that landed.
        sprite: u32,
        x: f64,
        y: f64,
        z: f64,
        /// It hit a fluid (the point is on its surface), not a solid block
        /// (the point is on the block's top).
        water: bool,
    }
    /// Adds a picture and gives its number; an error when it is refused (too
    /// big, wrong size of pixels, no room: 16 pictures in all, shared by
    /// the mods).
    define-sprite: func(sprite: sprite) -> result<u32, string>;
    /// Spawns one particle; false when it was refused (an unknown picture,
    /// or more than 512 particles in this call). At most a few thousand of
    /// the mods' particles live at once.
    spawn: func(options: options) -> bool;
    /// The mod's own particles that landed since the last call, oldest first.
    landed: func() -> list<landing>;
}

/// Capability `atmosphere`: the mod's own weather in the fog (API 0.1.6).
interface atmosphere {
    record haze {
        /// 0 to 1: how much of the fog's colour the haze takes.
        amount: f32,
        /// The colour it takes, each part 0 to 1.
        red: f32,
        green: f32,
        blue: f32,
        /// How much closer the fog comes: its end distance times
        /// `1 - density` (0 to 0.9).
        density: f32,
    }
    /// The haze of the mod; none for none. The game keeps it until the mod
    /// sets it again and drops it when the mod stops. With several mods the
    /// strongest haze counts.
    set-haze: func(haze: option<haze>);
}

/// Capability `overlay`: the mod's own graphics over the world, in the HUD's
/// layer, without taking the mouse or the keyboard (API 0.1.7). It draws the
/// elements `screen.paint` does.
interface overlay {
    use screen.{element, size};
    /// Where in the HUD an element goes.
    enum layer {
        /// Before the game draws its status bars (health, hunger, armour,
        /// air, experience): the bars are drawn over it.
        under-bars,
        /// After them, over every other part of the HUD but the chat and the
        /// screens.
        over-bars,
    }
    /// A point of the world with a picture drawn at it (a waypoint).
    variant world-element {
        label(world-label),
        sprite(world-sprite),
        fill(world-fill),
    }
    /// A line of text drawn at a point of the world, always facing the
    /// camera, at a size that does not change with the distance. Its
    /// middle is at the point, `offset-y` GUI pixels down.
    record world-label {
        x: f64,
        y: f64,
        z: f64,
        text: string,
        /// 0xAARRGGBB.
        color: u32,
        shadow: bool,
        scale: f32,
        offset-y: f32,
    }
    /// A sprite of the GUI atlas drawn at a point of the world, its middle
    /// at the point.
    record world-sprite {
        x: f64,
        y: f64,
        z: f64,
        width: f32,
        height: f32,
        name: string,
        /// 0xAARRGGBB.
        tint: u32,
        offset-y: f32,
    }
    /// A filled rectangle drawn at a point of the world, its middle at the
    /// point.
    record world-fill {
        x: f64,
        y: f64,
        z: f64,
        width: f32,
        height: f32,
        /// 0xAARRGGBB.
        color: u32,
        offset-y: f32,
    }
    /// What the HUD is doing.
    record hud-state {
        /// A screen (the inventory, the chat, the pause menu) is open.
        screen-open: bool,
        /// The debug screen (F3) is on.
        debug: bool,
        /// The HUD is hidden (F1).
        hidden: bool,
    }
    /// What to paint in a layer in the next frames; the elements of the last
    /// call stay until the mod paints again or clears. `picture` elements
    /// use the images of `upload-texture`.
    paint: func(layer: layer, elements: list<element>);
    /// Removes what the mod painted in the layer.
    clear: func(layer: layer);
    /// What to draw at points of the world; stays until the next call.
    /// The game projects the points with the camera of the last frame and
    /// leaves out those behind it.
    paint-world: func(elements: list<world-element>);
    /// Removes what the mod drew in the world.
    clear-world: func();
    /// The screen's size in GUI pixels; none when the game has no window.
    get-size: func() -> option<size>;
    /// The width of the text in GUI pixels at the game's font.
    get-text-width: func(text: string) -> f32;
    /// Uploads an RGBA image (`width * height * 4` bytes) under the id `id`
    /// (0 to 6); it is drawn by `picture` elements of the overlay. At most
    /// 7 images of 256x256 pixels shared by all the mods' overlays.
    upload-texture: func(id: u32, width: u32, height: u32, rgba: list<u8>) -> result<_, string>;
    /// What the HUD is doing; none outside a world.
    get-hud-state: func() -> option<hud-state>;
}

/// Capability `entity-read`: the entities around the player (API 0.1.8). With
/// capability `entity-edit` as well, removing entities and changing what an
/// experience orb is worth, in a world this game runs (single player, or one
/// it opened to LAN); in another's world the edits do nothing and return
/// false. What the game keeps of the other world's entities is what the
/// server told it.
interface %entity {
    /// What an entity is.
    enum entity-kind {
        /// A mob (a zombie, a cow, a villager, an armour stand).
        mob,
        /// An item lying in the world.
        item,
        /// A player other than the local one.
        player,
        /// Everything else: an experience orb, an arrow, a boat.
        other,
    }
    /// One entity.
    record entity {
        /// Its id in the world, as of the last tick.
        id: u32,
        /// `minecraft:zombie`, `minecraft:item`, `minecraft:experience_orb`, ...
        type-id: string,
        kind: entity-kind,
        /// Its name in the game's language (its custom name when it has one);
        /// an item's is the item's.
        name: string,
        /// A player's UUID; empty for the others.
        uuid: string,
        /// Where it is, as of the last tick, in blocks.
        x: f64,
        y: f64,
        z: f64,
        /// Where it faces, in degrees.
        yaw: f32,
        /// Its height in blocks.
        height: f32,
        /// Its health when it has one; 0 for an entity without.
        health: f32,
        max-health: f32,
        /// What an experience orb is worth; 0 for every other entity.
        xp: u32,
        /// It is burning.
        on-fire: bool,
        /// A mob that attacks the player (the game's monster category).
        hostile: bool,
        /// What it holds in its main hand and its off hand; an item's own
        /// item in `held-item`.
        held-item: option<string>,
        off-hand-item: option<string>,
    }
    /// A player's face as an image.
    record face {
        width: u32,
        height: u32,
        /// `width * height * 4` bytes, RGBA.
        rgba: list<u8>,
    }
    /// The entities of the kind (`minecraft:experience_orb`, ...) within
    /// `radius` blocks of the player (at most 512 blocks); every kind when
    /// `type-id` is empty. The nearest first, at most 1024. Empty outside a
    /// world.
    nearby: func(type-id: string, radius: f64) -> list<entity>;
    /// `entity-edit`: removes the entity with that id; false when there is
    /// no such entity or the world is not this game's.
    remove: func(id: u32) -> bool;
    /// `entity-edit`: sets what an experience orb is worth; false for
    /// another entity or a world this game does not run.
    set-xp: func(id: u32, xp: u32) -> bool;
    /// The face of the player with that UUID (the 8 by 8 face and hat of
    /// the skin); none when the game has no skin of theirs. None for now
    /// for every UUID: the skins are not given to mods yet.
    get-face: func(uuid: string) -> option<face>;
}

/// Capabilities `slots-read` and `slot-decorate`: the game's own slots, the
/// one under the cursor, and the marks the mod has the game draw on them
/// (API 0.1.10).
interface slots {
    /// What to draw on a slot: 16 by 16 GUI pixels where an item is.
    variant mark-shape {
        /// A frame one pixel thick around the slot.
        frame(frame-mark),
        /// A square in the slot's top right corner.
        dot(dot-mark),
        /// The whole slot filled (a highlight).
        fill(fill-mark),
    }
    record frame-mark {
        /// 0xAARRGGBB.
        color: u32,
    }
    record dot-mark {
        /// 0xAARRGGBB.
        color: u32,
        /// The side of the square in GUI pixels.
        size: f32,
    }
    record fill-mark {
        /// 0xAARRGGBB.
        color: u32,
    }
    /// A mark on one of the game's slots.
    record mark {
        /// The slot's id: 0 to 8 the hotbar (on the HUD, in the inventory and
        /// in the creative inventory's item tab), 9 to 35 the rest of the
        /// inventory, 100 to 108 the crafting grid, 200 the crafting result,
        /// 300 and up a container's slots, 500 to 503 the armour (head to
        /// feet), 504 the off hand.
        slot: u32,
        shape: mark-shape,
    }
    /// `slot-decorate`: the marks the game draws on its slots, in the HUD's
    /// hotbar and in the open screen with slots; a mark of a slot that is not
    /// on screen is kept and not drawn. They stay until the mod sets them
    /// again (an empty list clears them), and go when the mod stops. At most
    /// 256 marks.
    set-marks: func(marks: list<mark>);
    /// `slots-read`: the slot under the cursor in the open screen with slots
    /// (the inventory, a container); none otherwise.
    get-hovered-slot: func() -> option<u32>;
}

/// Capability `tooltip`: what the mod adds to the tooltip the game draws for
/// an item (API 0.1.11).
interface tooltip {
    use screen.{element};
    /// The item whose tooltip the game drew in the last frame (inventory,
    /// containers, the creative inventory), with the tooltip's frame.
    record hovered {
        /// `minecraft:cooked_beef`, ...
        item: string,
        /// The frame in GUI pixels.
        x: f32,
        y: f32,
        width: f32,
        height: f32,
    }
    /// What the mod adds under the tooltip's text: the room it takes and
    /// what is drawn in it. The elements' positions are from the top left
    /// of that room; `picture` elements use the images of
    /// `overlay.upload-texture`.
    record content {
        width: f32,
        height: f32,
        elements: list<element>,
    }
    /// The item the game drew a tooltip for in the last frame; none when
    /// the cursor was over none.
    get-hovered: func() -> option<hovered>;
    /// What to add to the tooltip of the item (all stacks of that item id);
    /// none removes it. It stays until the mod changes it, and goes with
    /// the mod. Up to 32 items, 64 elements each, and 128 by 128 pixels.
    set-content: func(item: string, content: option<content>);
}

/// Capability `resource-read`: the files of the enabled resource packs, as
/// the game merges them (API 0.1.14).
interface resources {
    /// The namespaces the packs have files for: `minecraft` and the packs'
    /// own, sorted.
    namespaces: func() -> list<string>;
    /// The files under `assets/<namespace>/<prefix>`, as paths relative to
    /// `assets/<namespace>/` (`optifine/ctm/glass/0.properties`,
    /// `textures/block/glass.png`), sorted; an empty prefix lists all. At
    /// most 20000.
    list-files: func(namespace: string, prefix: string) -> list<string>;
    /// A file's bytes (up to 32 MiB); none when there is no such file.
    read-file: func(namespace: string, path: string) -> option<list<u8>>;
}

/// Capability `texture-rules`: what the faces of blocks show (API 0.1.14).
/// The mod gives pictures and rules; the mesher applies them to each face it
/// draws, so no mod code runs per face.
interface texture-rules {
    /// A block state a rule matches.
    record block-filter {
        /// `minecraft:glass`, ...
        id: string,
        /// Properties the state must have, all of them (`axis`=`y`).
        properties: list<tuple<string, string>>,
    }
    /// When a neighbour counts as connected.
    enum connect {
        /// The same block (id), whatever its properties.
        block,
        /// The same state (id and every property).
        state,
        /// A neighbour that shows the same picture on the same side.
        tile,
    }
    /// How the face's tile is chosen.
    enum method {
        /// By the pattern of connected neighbours (`pattern-tiles`).
        pattern,
        /// By the face's position, weighted (`tiles` and `weights`).
        random,
        /// By the block's place along the face (`grid-tiles`).
        position,
        /// Four quarters of the face, each with its own table
        /// (`quarter-tiles`).
        quarters,
    }
    record rule {
        /// States the rule matches.
        blocks: list<block-filter>,
        /// Pictures the rule matches: `minecraft:block/glass`. A face that
        /// shows one of them uses the rule too.
        sprites: list<string>,
        /// Faces the rule matches, a mask: north 1, east 2, south 4, west 8,
        /// up 16, down 32.
        faces: u32,
        connect: connect,
        method: method,
        /// The pictures the rule may draw: names of `upload-sprite` (the
        /// game adds the mod's id), or a picture of the game's own
        /// (`minecraft:block/glass`).
        tiles: list<string>,
        /// `pattern`: the tile of each of the 256 patterns, an index in
        /// `tiles`; 4294967295 for none. Bits: 1 the neighbour on the left of
        /// the face, 2 lower left, 4 below, 8 lower right, 16 right, 32
        /// upper right, 64 above, 128 upper left. Left and right follow the
        /// picture's `u`, below follows its `v`.
        pattern-tiles: list<u32>,
        /// `quarters`: eight tiles for each quarter (upper left, upper
        /// right, lower left, lower right), indexed by 1 side neighbour
        /// connected (the one on the quarter's horizontal side), 2 vertical
        /// side, 4 diagonal.
        quarter-tiles: list<u32>,
        /// `position`: the tile of each cell of a `width` by `height` grid,
        /// row by row; the cell is `(v mod height) * width + (u mod width)`
        /// for the block's `u` along the face (to the right) and `v` (down).
        grid-tiles: list<u32>,
        width: u32,
        height: u32,
        /// `random`: each tile's weight; a missing one weighs 1.
        weights: list<u32>,
    }
    /// Adds a picture (PNG) to the block atlas under `name`; the same name
    /// replaces the old picture. The game rebuilds the atlas and meshes the
    /// world again. At most 512 pictures a mod, 1 MiB each.
    upload-sprite: func(name: string, png: list<u8>) -> result<_, string>;
    /// Adds a rule; rules are tried in the order they were added (the mods'
    /// in turn), and the first that gives a tile wins. At most 512 a mod.
    register-rule: func(rule: rule) -> result<_, string>;
    /// Removes every rule and picture of this mod.
    clear-rules: func();
}

/// Capability `lighting`: light sources the mod gives the world, like a
/// torch in the player's hand (API 0.1.13). Nothing is relit: the game keeps
/// the sources nearest the camera and the shaders raise the block light of
/// what they reach, one level less per block of distance, before the
/// lightmap.
interface lighting {
    record light {
        /// Where the source is, in the world.
        x: f64,
        y: f64,
        z: f64,
        /// 0 to 15, as block light.
        level: u8,
    }
    /// The mod's light sources; the game keeps them until the mod sets
    /// another list (an empty one removes its light) and drops them when
    /// the mod stops. Up to 256 sources; the game draws the 16 nearest
    /// the camera that can still light something in sight. Call it from
    /// `frame` or `tick`.
    set-lights: func(lights: list<light>);
    /// The light a block gives off (`lightEmission`), 0 to 15; 0 for an
    /// id that is not a block or an unknown one.
    get-block-emission: func(id: string) -> u8;
}

/// Capability `debug`: lines the mod adds to the debug screen (F3) (API
/// 0.1.11).
interface debug {
    /// The mod's lines, in a group of their own; an empty list removes the
    /// group. At most 16 lines of 256 characters.
    set-lines: func(lines: list<string>);
}

/// What the game calls. Only the hooks `init` asks for are ever called.
interface events {
    record registration {
        /// Chat commands, without the slash. A name vanilla already uses is
        /// refused (vanilla's command runs).
        commands: list<string>,
        /// Call `tick` every game tick (20 per second while playing).
        tick: bool,
        /// Call `frame` every rendered frame. Budget: 0.1 ms.
        frame: bool,
        /// Call `chat` for each chat line the player receives.
        chat: bool,
    }
    /// Once, after loading. An error keeps the mod off and is shown.
    init: func() -> result<registration, string>;
    tick: func(tick: u64);
    frame: func(seconds: f32);
    /// `/name args`: ok(some(text)) is shown as feedback, err(text) in red.
    command: func(name: string, args: string) -> result<option<string>, string>;
    chat: func(text: string);
}

world horizon-mod {
    import log;
    import game;
    import chat;
    import hud;
    import target;
    import inventory;
    import hotbar;
    import keys;
    import storage;
    import screen;
    import items;
    import recipes;
    import weather;
    import settings;
    import particles;
    import atmosphere;
    import overlay;
    import %entity;
    import slots;
    import tooltip;
    import debug;
    import lighting;
    import chat-decorate;
    import resources;
    import texture-rules;
    import %world;
    export events;
}

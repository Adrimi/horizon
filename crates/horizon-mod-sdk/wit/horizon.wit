/// The contract between Horizon and its mods (docs/mods.md).
///
/// A mod is a WebAssembly component targeting the `mod` world. Each imported
/// interface but `log` is a capability: the mod's manifest lists the ones it
/// uses, the player sees them before turning the mod on, and the game refuses
/// a component that imports one its manifest does not declare.
package horizon:mods@0.1.35;

/// The mod's log, in the game's log under the mod's id. Always granted.
interface log {
    enum level {
        debug,
        info,
        warn,
        error,
    }
    /// One line in the game's log as `[mod <id>] message`, at that level.
    write: func(level: level, message: string);
}

/// Capability `game-read`: the local player and the world clock.
interface game {
    /// What the player's keys do now (API 0.1.16).
    record input-state {
        /// The player is sneaking.
        sneaking: bool,
        /// The attack button (the left mouse button) is held.
        attacking: bool,
    }
    record player {
        /// Feet position, in blocks.
        x: f64,
        y: f64,
        z: f64,
        /// Degrees, as F3 shows them.
        yaw: f32,
        /// Degrees: -90 looks straight up, 90 straight down.
        pitch: f32,
        /// Hit points as vanilla counts them: 20 is full health without effects.
        health: f32,
        /// 0 to 20, as the hunger bar.
        food: u32,
        /// `minecraft:overworld`, `minecraft:the_nether`, ...
        dimension: string,
    }
    record clock {
        /// Ticks since the world was created.
        game-time: u64,
        /// 24000 ticks per day; 0 is 6:00 on the first day.
        day-time: u64,
    }
    /// None on the title screen.
    get-player: func() -> option<player>;
    /// The player's sneaking and attack button; none outside a world (API
    /// 0.1.16).
    get-input-state: func() -> option<input-state>;
    /// None on the title screen.
    get-clock: func() -> option<clock>;
    /// Hunger as `FoodData` keeps it (API 0.1.2).
    record food-stats {
        /// 0 to 20, as `player.food`.
        food: u32,
        /// 0 to `food`: what is spent before hunger drops.
        saturation: f32,
        /// 0 to 40; every 4 takes one saturation (or food) point.
        exhaustion: f32,
    }
    /// None on the title screen (API 0.1.2).
    get-food-stats: func() -> option<food-stats>;
    /// `game-read` (API 0.1.24): the player's game mode: `survival`,
    /// `creative`, `adventure` or `spectator`; none outside a world.
    get-game-mode: func() -> option<string>;
    /// `game-read` (API 0.1.24): the player's tags, the ones `/tag` sets, as
    /// of the last tick; empty outside a world.
    get-player-tags: func() -> list<string>;
    /// `game-read` (API 0.1.25): the height of the clouds in the world the
    /// player is in, in blocks; none outside a world and in a dimension with
    /// no clouds.
    get-cloud-height: func() -> option<s32>;
    /// The window as the game draws it (API 0.1.32).
    record viewport {
        /// Screen pixels in one GUI pixel (4.0 at GUI scale 4).
        gui-scale: f32,
        /// The window's width in screen pixels.
        width: f32,
        /// The window's height in screen pixels.
        height: f32,
    }
    /// `game-read` (API 0.1.32): the window's size and GUI scale; none when
    /// the game has not drawn a frame yet.
    get-viewport: func() -> option<viewport>;
    /// `game-read` (API 0.1.32): the view distance, in chunks, of the world
    /// the player is in when this game runs it (its own or a LAN host's:
    /// the render distance); 0 when it is not known (another's server).
    get-server-view-distance: func() -> u32;
    /// `game-edit` (API 0.1.23): adds exhaustion to the player, as
    /// `Player.causeFoodExhaustion` does (4 makes one hunger point go); 0 or
    /// less does nothing, at most 40 a call. Made after the hook, in a world
    /// this game runs.
    add-exhaustion: func(amount: f32);
    /// `game-edit` (API 0.1.23): the mod's modifier of the player's mining
    /// speed, added to the base as `Attributes.BLOCK_BREAK_SPEED`'s
    /// `ADD_MULTIPLIED_BASE` does: speed times `1 + sum of the mods'
    /// modifiers`, at least 0. 0 is no change; it replaces the mod's earlier
    /// one and goes with the mod.
    set-break-speed-modifier: func(multiplier: f64);
    /// The world's seed; none when the game does not know it, as in
    /// another's world (API 0.1.7).
    get-seed: func() -> option<u64>;
    /// The field of view the game drew the last frame with, in degrees, the
    /// vertical one; none outside a world (API 0.1.7).
    get-fov: func() -> option<f32>;
    /// The world the player is in (API 0.1.10).
    record session {
        /// A number that changes with every world loaded and every server
        /// joined.
        id: u64,
        /// The milliseconds since that world was loaded.
        elapsed-ms: u64,
    }
    /// The world the player is in; none outside a world (API 0.1.10).
    get-session: func() -> option<session>;
    /// The player's health (API 0.1.11).
    record health {
        health: f32,
        /// The most health the player can have.
        max-health: f32,
        /// The absorption (the golden hearts).
        absorption: f32,
    }
    /// The player's health; none outside a world (API 0.1.11).
    get-health: func() -> option<health>;
    /// The ids of the effects on the player (`minecraft:poison`,
    /// `minecraft:regeneration`, ...); empty when there is none (API 0.1.11).
    get-effects: func() -> list<string>;
    /// The world's difficulty: `peaceful`, `easy`, `normal` or `hard`; none
    /// outside a world (API 0.1.11).
    get-difficulty: func() -> option<string>;
    /// The hand the player holds the main item in, `left` or `right`
    /// (the Main Hand option; API 0.1.34; `game-read`).
    get-main-hand: func() -> string;
    /// The display name of the mod that owns a namespace: `minecraft` is
    /// "Minecraft", `horizon` is "Horizon", a loaded mod's namespace is the
    /// mod's name; the namespace itself when the game knows none (API
    /// 0.1.35; `game-read`).
    get-mod-name: func(namespace: string) -> string;
    /// The game's line for a translation key in the language of the game
    /// (`effect.minecraft.speed` is "Speed"); the key itself when the
    /// language has none (API 0.1.35; `game-read`).
    get-translation: func(key: string) -> string;
    /// With capability `narrate`: asks for the text to be read aloud (API
    /// 0.1.35). Horizon has no speech engine yet, so the game only records
    /// the request in its log (`[narrator] <mod>: <text>`); a speech engine
    /// will read the same requests. Without the capability it does nothing.
    narrate: func(text: string);
    /// The narrator's mode: `off` while the game has no narrator (API
    /// 0.1.35; `game-read`). A mod that narrates only when it is not `off`
    /// stays silent until the game gains one.
    get-narration-mode: func() -> string;
}

/// Capability `chat`: messages only the local player sees.
interface chat {
    /// Shown in chat after the mod's name, like a system message.
    show: func(text: string);
    /// The player who wrote a chat message (API 0.1.15).
    record sender {
        /// Their name; empty when the game does not know it (they are not
        /// in the player list).
        name: string,
        /// Their UUID as 32 hexadecimal characters, no hyphens.
        uuid: string,
    }
    /// A chat message the player received (API 0.1.15).
    record message {
        /// The message's number in this session: grows, never repeats.
        id: u64,
        /// Its text, without formatting, as the `chat` hook gets it.
        text: string,
        /// Who wrote it; none for a system message, `/say` and a message
        /// whose sender the server hid.
        sender: option<sender>,
    }
    /// The messages received since the last tick, oldest first, the same
    /// for every mod. The game adds a message to this list *before* it calls
    /// the `chat` hook, so a mod that reads it in the hook finds that
    /// message last (API 0.1.15).
    get-messages: func() -> list<message>;
}

/// Capability `chat-decorate`: a picture before a chat message and the room
/// the game leaves for it (API 0.1.15). The mod says once which picture a
/// message gets; the game draws it and indents the text, so no mod code
/// runs when the chat is drawn.
interface chat-decorate {
    /// Where a picture comes from.
    variant source {
        /// The skin of the player who wrote the message (64 by 64): the
        /// one the player list has downloaded, else the default skin for
        /// their UUID.
        sender-skin,
        /// The skin of the player with this UUID (32 hexadecimal
        /// characters), 64 by 64.
        player-skin(string),
        /// A sprite of the game's GUI atlas by name (`hud/heart/full`).
        sprite(string),
    }
    /// A rectangle of the source, in pixels.
    record region {
        x: u32,
        y: u32,
        width: u32,
        height: u32,
    }
    record picture {
        source: source,
        /// The rectangles to draw, one over the other in the same place
        /// (a face and its hat); empty draws the sprite whole. At most 8.
        regions: list<region>,
        /// The picture's size on screen, in GUI pixels (1 to 64).
        width: u32,
        height: u32,
    }
    /// The picture before the message with this id, or none for no picture.
    /// Set it in the `chat` hook, before the game adds the message to the
    /// chat; the picture then starts the message's first line and the text
    /// of all its lines is indented by `width + 2` pixels. The first mod to
    /// give a picture for a message wins.
    set-picture: func(id: u64, picture: option<picture>);
    /// Where a picture stands (API 0.1.18).
    variant place {
        /// At the start of the first line; the text of every line of the
        /// message is indented by the picture's width and the gap.
        line-start,
        /// Before this character of the message's text (counted from 0 in
        /// the text `chat.get-messages` gives): the first line is cut
        /// there, the picture stands between the parts and the rest of the
        /// line follows it. A number past the first line puts the picture
        /// at its end.
        text(u32),
    }
    /// How one rectangle of a picture is drawn (API 0.1.18).
    record style {
        /// Offset on the screen, in GUI pixels, from the picture's place.
        offset-x: s32,
        offset-y: s32,
        /// Size on the screen, in GUI pixels; 0 is the picture's own size.
        width: u32,
        height: u32,
        /// 0xRRGGBB multiplied with the texture (a shadow is a dark one);
        /// 0 is the line's colour. The line's fading applies to it.
        color: u32,
    }
    /// A picture with all of how it is drawn (API 0.1.18).
    record decoration {
        picture: picture,
        /// The room left after the picture, in GUI pixels; none is 2, as
        /// `set-picture` leaves it, and 0 lets the text touch it.
        gap: option<u32>,
        place: place,
        /// How to draw each rectangle of `picture`, by index, in order (a
        /// shadow is the first rectangle again, offset and dark); missing
        /// entries draw a rectangle as it is.
        styles: list<style>,
    }
    /// The picture of the message with this id, with all of how it is drawn,
    /// or none for no picture; `set-picture` is this with a gap of 2, the
    /// start of the line and no styles. Skin pictures of a player who hangs
    /// upside down are drawn upside down (API 0.1.18).
    set-decoration: func(id: u64, decoration: option<decoration>);
}

/// Capability `players`: the players of the world, from the player list (API
/// 0.1.18).
interface players {
    record player {
        /// Their profile name.
        name: string,
        /// The name the player list shows (a team's prefix, a nickname);
        /// empty when it is the profile name.
        display-name: string,
        /// Their UUID as 32 hexadecimal characters, no hyphens.
        uuid: string,
    }
    /// The players in the player list; empty outside a world.
    get-players: func() -> list<player>;
}

/// Capability `light-events` (API 0.1.20): things that shine in the world
/// without being an entity, as data the mod lights as it likes.
interface light-events {
    record flash {
        /// What it is: `minecraft:beacon_beam`, `minecraft:guardian_beam`,
        /// `minecraft:firefly`, `minecraft:sonic_boom`.
        kind: string,
        /// Where it is: a beam's start, a particle's position.
        x: f64,
        y: f64,
        z: f64,
        /// A beam's end (the top of a beacon's beam, a guardian's target);
        /// equal to the start for a particle.
        end-x: f64,
        end-y: f64,
        end-z: f64,
        /// How long it shines from now, in ticks (a standing beam: 2, to be
        /// reported again while it stands).
        ticks: u32,
    }
    /// The flashes since the last tick of the mod: the beams that stand
    /// within 128 blocks of the player and the particles spawned since.
    /// Empty when nothing shines. At most 256.
    poll: func() -> list<flash>;
}

/// Capability `input` (API 0.1.23): the mouse while the player plays, with no
/// screen open.
interface input {
    record mouse-event {
        /// The wheel: positive up, negative down; 0 for a button.
        wheel: f32,
        /// 0 left, 1 right, 2 middle; -1 for the wheel.
        button: s32,
        /// The button went down (false: up). Always false for the wheel.
        pressed: bool,
        /// Where the cursor is, in GUI pixels.
        x: f32,
        y: f32,
    }
    /// The events since the last call, oldest first (at most 64 are kept).
    poll: func() -> list<mouse-event>;
    /// Whether the game leaves the wheel to the mod: while true the wheel
    /// does not change the hotbar slot (the roulette of a mod). Stays until
    /// the mod changes it, and goes with the mod.
    set-wheel-captured: func(captured: bool);
}

/// Capability `audio` (API 0.1.22): sounds of the game the mod plays.
interface audio {
    /// Where a sound is heard from, in the world.
    record sound-place {
        x: f64,
        y: f64,
        z: f64,
    }
    /// Plays a sound of the game (`minecraft:weather.rain`,
    /// `minecraft:item.snowball.throw`) after the hook; at the place when
    /// there is one, else as if from the player. The volume is 0 to 4, the
    /// pitch 0.5 to 2. False for a name that is not `namespace:path`, a
    /// sound the game does not have, or more than 16 sounds in one hook.
    play: func(sound: string, place: option<sound-place>, volume: f32, pitch: f32) -> bool;
    /// Adds the mod's own sound, an OGG Vorbis file, to the game (API
    /// 0.1.25) and names it `<mod id>:<name>` to `play` (a name is
    /// `[a-z0-9_.-]`, up to 64 characters). The file goes to the mod's own
    /// folder, so it is there after a restart; at most 16 sounds of 2 MiB
    /// each. Since API 0.1.29 the bytes may also be a PCM WAV file (16-bit, any
    /// rate; a mod can write one itself, no encoder needed). An error for a
    /// file that is neither or does not decode.
    register: func(name: string, ogg: list<u8>) -> result<_, string>;
    /// Adds the sound file `sounds/<name>.ogg` (or, since API 0.1.29,
    /// `sounds/<name>.wav`, PCM) that the mod carries in its
    /// own `.hmod` (API 0.1.26; `cargo-horizon-mod build` packs the
    /// `sounds/` folder of the crate) under `<mod id>:<name>`, as
    /// `register` does. An error for a name the mod has no file for, or a
    /// file that is not OGG or does not decode.
    register-file: func(name: string) -> result<_, string>;
}

/// Capability `hud`: one panel of text lines per mod, drawn by the game
/// every frame until the mod changes or clears it (no call per frame).
interface hud {
    enum corner {
        top-left,
        top-right,
        bottom-left,
        bottom-right,
    }
    record line {
        /// Plain text, up to 256 characters.
        text: string,
        /// 0xRRGGBB.
        color: u32,
    }
    /// Replaces the mod's panel: up to 16 lines in that corner of the screen.
    set-panel: func(corner: corner, lines: list<line>);
    /// Removes the mod's panel.
    clear: func();
    /// Shows a line over the hotbar, as vanilla's action bar does (API
    /// 0.1.16); it fades after about three seconds, and a new one replaces
    /// it. `color` is 0xRRGGBB; the text may have `§` formatting. An empty
    /// text does nothing.
    show-action-bar: func(text: string, color: u32);
    /// One icon of a status bar as the game drew it (API 0.1.7).
    record bar-icon {
        /// The top left corner in GUI pixels, after the shaking of the bar.
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        /// The sprite the game drew (`hud/food_empty`, `hud/heart/container`,
        /// ...).
        name: string,
    }
    /// The health and hunger bars as the game drew them in the last frame.
    record bars {
        /// The container of each hunger icon, in the order the game drew
        /// them.
        food: list<bar-icon>,
        /// The container of each heart, in the order the game drew them.
        health: list<bar-icon>,
    }
    /// Where the bars are; none when the game draws none (creative,
    /// spectator, the HUD hidden). One frame old (API 0.1.7).
    get-bars: func() -> option<bars>;

    /// A boss bar the game draws at the top of the screen (API 0.1.34).
    record boss-bar {
        /// The name above the bar, without formatting.
        name: string,
        /// Where the bar ends, in GUI pixels from the top of the screen
        /// (the bar's 5 pixels; the next starts 19 below the one before).
        y-bottom: f32,
    }
    /// The boss bars the game draws now, from the top; empty when there is
    /// none (API 0.1.34; `hud`). A panel under them starts below the last.
    get-boss-bars: func() -> list<boss-bar>;
    /// With capability `hud-write`: hides the game's boss bars while the
    /// mod says so (API 0.1.35). They stay hidden while any running mod
    /// says so, and come back when the mod says `false` or stops. Without
    /// the capability it does nothing.
    set-boss-bars-hidden: func(hidden: bool);
}

/// Capability `target`: the block the player looks at, and the one they
/// are breaking (API 0.1.1).
interface target {
    record block {
        x: s32,
        y: s32,
        z: s32,
        /// `minecraft:stone`, ...
        id: string,
        /// Vanilla's destroy time; -1 for a block that cannot be broken.
        hardness: f32,
        /// Drops only when broken with the correct tool.
        requires-tool: bool,
        /// Every block tag it is in: `minecraft:mineable/pickaxe`,
        /// `minecraft:needs_iron_tool`, `minecraft:leaves`, ...
        tags: list<string>,
    }
    /// The block under the crosshair within reach; none on air, an entity
    /// or the title screen.
    get-block: func() -> option<block>;
    /// The block the player is breaking (the attack button held on it in
    /// survival or adventure), from its first tick to its last.
    get-breaking: func() -> option<block>;
    /// How far that block is broken, 0 to 1; none when none is (API 0.1.2).
    get-breaking-progress: func() -> option<f32>;
    /// The looked-at block's name in the game's language (`Block.getName`),
    /// its id when the language has none; none as `get-block` (API 0.1.2).
    get-block-name: func() -> option<string>;
    /// A living entity under the crosshair (API 0.1.2).
    record entity {
        /// Its id in the world this tick.
        id: u32,
        /// `minecraft:zombie`, ...
        type-id: string,
        /// Its custom name, else its type's name in the game's language.
        name: string,
        health: f32,
        max-health: f32,
    }
    /// The mob the attack button would hit (`EntityHitResult`) within
    /// reach, before any block; none otherwise (API 0.1.2).
    get-entity: func() -> option<entity>;
    /// The armour points of the mob under the crosshair
    /// (`LivingEntity.getArmorValue`: its type's, not what it wears); none
    /// as `get-entity` (API 0.1.9).
    get-entity-armor: func() -> option<f32>;
    /// The absorption of the mob under the crosshair; none as `get-entity`.
    /// The game does not track a mob's absorption: 0 (API 0.1.9).
    get-entity-absorption: func() -> option<f32>;
    /// The face of the block under the crosshair that the player looks at:
    /// `north`, `south`, `east`, `west`, `up` or `down`; none as `get-block`
    /// (API 0.1.9).
    get-block-face: func() -> option<string>;

    /// A status effect on a mob (API 0.1.34).
    record effect {
        /// The effect's id, e.g. `minecraft:speed`.
        id: string,
        /// 0 for level I.
        amplifier: u32,
        /// The ticks left; -1 when the effect lasts for ever.
        duration-ticks: s32,
        /// Given by a beacon or a conduit: its particles are faint.
        ambient: bool,
        /// Shown in the game's own effect icons and particles.
        visible: bool,
    }
    /// The effects on the mob under the crosshair; none as `get-entity`
    /// (API 0.1.34; `target`). The game knows the effects of the mobs it
    /// simulates or is told of: a mob it was not told of has none.
    get-entity-effects: func() -> option<list<effect>>;

    /// The block under a ray of `reach` blocks (0 to 32; the game's own reach
    /// is 4.5, 5 in creative) from the player's eyes, or, with `from-eye`
    /// false, from the camera and along its view (the third-person
    /// perspectives); none as `get-block` (API 0.1.34). The first block
    /// along the ray, as `get-block` finds it.
    get-block-ex: func(reach: f32, from-eye: bool) -> option<block>;
    /// The face of that block, as `get-block-face` (API 0.1.34).
    get-block-face-ex: func(reach: f32, from-eye: bool) -> option<string>;
    /// The mob under that ray, nearer than the block it hits (API 0.1.34).
    get-entity-ex: func(reach: f32, from-eye: bool) -> option<entity>;

    /// A fluid under the crosshair (API 0.1.34).
    record fluid {
        /// `minecraft:water` or `minecraft:lava`.
        id: string,
        /// The name in the game's language.
        name: string,
        /// The block state's `level`: 0 for a source, 1 to 7 for flowing
        /// fluid (more is lower), 8 and up for falling fluid.
        level: u32,
    }
    /// The fluid the crosshair is on, within the game's reach (API 0.1.34).
    /// `mode`: `any` gives the first fluid on the ray, even before a block;
    /// `fallback` gives it only when the ray hits no block; `none` (and any
    /// other word) gives none, as a game that ignores fluids does.
    get-fluid: func(mode: string) -> option<fluid>;

    /// The `BlockBehaviour.Properties` of the block under the crosshair
    /// (API 0.1.35).
    record block-properties {
        explosion-resistance: f32,
        /// `jumpFactor`: 1 for most, 0.5 for honey.
        jump-factor: f32,
        /// `speedFactor`: 1 for most, 0.4 for soul sand and honey.
        speed-factor: f32,
        /// `FireBlock`'s ignite odds, 0 for a block fire does not take.
        ignite-odds: u32,
        /// `FireBlock`'s burn odds.
        burn-odds: u32,
    }
    /// The properties of the block under the crosshair; none as `get-block`
    /// (API 0.1.35; `target`).
    get-block-properties: func() -> option<block-properties>;
    /// The loot table of the block under the crosshair
    /// (`minecraft:blocks/stone`); none as `get-block`, and for a block
    /// without one (API 0.1.35).
    get-block-loot-table: func() -> option<string>;

    /// A fluid under the crosshair and where it is (API 0.1.35).
    record fluid-ex {
        id: string,
        name: string,
        level: u32,
        /// The block the fluid is in.
        x: s32,
        y: s32,
        z: s32,
        /// The block texture of the fluid (`minecraft:block/water_still`).
        sprite: string,
    }
    /// As `get-fluid`, with the fluid's block and sprite (API 0.1.35).
    get-fluid-ex: func(mode: string) -> option<fluid-ex>;
}

/// Capability `inventory-read`: the player's hotbar (API 0.1.1).
interface inventory {
    record stack {
        /// `minecraft:iron_pickaxe`, ...
        id: string,
        count: u32,
        damage: u32,
        /// 0 for an item that does not wear out.
        max-damage: u32,
        /// Its Efficiency level, 0 without.
        efficiency: u32,
        /// How fast it breaks the targeted block (the one being broken,
        /// else the one looked at): `Tool.getMiningSpeed` plus Efficiency's
        /// `mining_efficiency`, as `Player.getDestroySpeed` adds it. 1 for a
        /// hand, or with no block targeted.
        mining-speed: f32,
        /// `Tool.isCorrectForDrops` for that block.
        correct-for-drops: bool,
    }
    /// Slots 0 to 8; none for an empty slot.
    get-hotbar: func() -> list<option<stack>>;
    /// The selected slot, 0 to 8.
    get-selected: func() -> u32;
    /// What eating a stack gives: its `minecraft:food` component (API 0.1.2).
    record food {
        nutrition: u32,
        /// Added to saturation, as `FoodData.eat` adds it.
        saturation: f32,
    }
    /// The food in hotbar slot 0 to 8; none for an empty slot, an item
    /// that is not food or another slot (API 0.1.2).
    get-food: func(slot: u32) -> option<food>;
    /// Every item tag `id` is in, as full names without `#`:
    /// `minecraft:axes`, `minecraft:pickaxes`, `minecraft:swords`, ...
    /// Nested tags are already expanded, as vanilla's `TagLoader` does.
    /// Empty for an unknown id (API 0.1.3).
    item-tags: func(id: string) -> list<string>;
    /// Every item tag the item in hotbar slot 0 to 8 is in (API 0.1.3);
    /// empty for an empty slot, another slot or an unknown item.
    get-tags: func(slot: u8) -> list<string>;
    /// A stack with everything that tells it apart from another one (API
    /// 0.1.10).
    record item-stack {
        /// `minecraft:iron_pickaxe`, ...
        id: string,
        count: u32,
        /// The durability used; 0 for an item that does not wear out.
        damage: u32,
        /// The item's other components (enchantments, a custom name, a
        /// potion's contents, a trim, a container's items): opaque text, the
        /// same for stacks that are the same thing, empty for a plain stack.
        components: string,
    }
    /// The player's whole inventory.
    record player-inventory {
        /// The 36 slots: the hotbar (0 to 8) and the rest (9 to 35).
        slots: list<option<item-stack>>,
        /// The armour: head, chest, legs, feet.
        armour: list<option<item-stack>>,
        /// The off hand.
        offhand: option<item-stack>,
        /// The stack on the cursor.
        carried: option<item-stack>,
    }
    /// A crafting grid and what it makes.
    record crafting {
        /// The grid's cells in row order: 4 for the player's 2x2, 9 for a
        /// crafting table's 3x3.
        grid: list<option<item-stack>>,
        /// What the grid makes; none when it makes nothing.
        output: option<item-stack>,
    }
    /// The player's whole inventory; none outside a world (API 0.1.10).
    get-inventory: func() -> option<player-inventory>;
    /// The crafting grid and its result while the player's inventory or a
    /// crafting table is open; none otherwise (API 0.1.10).
    get-crafting: func() -> option<crafting>;
    /// Capability `inventory-edit` (API 0.1.5): gives the player `count` of
    /// the item `id`, as the creative inventory does: the stack goes into
    /// the inventory, and what does not fit is dropped. False (and nothing
    /// happens) without the capability, for an unknown id, a count of 0,
    /// when the player is not in creative, or in a world another game runs.
    give: func(id: string, count: u32) -> bool;
    /// What eating the item with that id gives (`minecraft:cooked_beef`, ...);
    /// none when it is not food (API 0.1.11).
    get-food-of: func(id: string) -> option<food>;
    /// Whether eating the item can hurt: one of its effects is Hunger
    /// (rotten flesh, a pufferfish, raw chicken); the game draws such food
    /// with the "hunger" icons (API 0.1.11).
    get-harmful-food: func(id: string) -> bool;
    /// The stack in the off hand; none when it is empty (API 0.1.11).
    get-offhand: func() -> option<stack>;
    /// An item of the hotbar as a tool (API 0.1.16).
    record tool {
        /// `minecraft:iron_pickaxe`, ...
        id: string,
        /// Always true: only items with a `minecraft:tool` component are
        /// listed (`ItemStack.has(DataComponents.TOOL)`).
        has-tool: bool,
        /// `Tool.damagePerBlock`: the wear one block it breaks gives it.
        damage-per-block: u32,
        /// Its enchantments: id (`minecraft:efficiency`) and level.
        enchantments: list<tuple<string, u32>>,
    }
    /// The tool in each of the hotbar's slots 0 to 8 (the same indices as
    /// `get-hotbar`); none for an empty slot and for an item without a
    /// `minecraft:tool` component (a block, food, ...) (API 0.1.16).
    get-tools: func() -> list<option<tool>>;
    /// A slot of the player's inventory (API 0.1.16).
    record slot {
        /// 0 to 8 the hotbar, 9 to 35 the rest, 36 to 39 the armour (feet,
        /// legs, chest, head), 40 the off hand.
        index: u32,
        /// The item; an empty string for an empty slot.
        id: string,
        count: u32,
        /// The durability used.
        damage: u32,
        /// 0 for an item that does not wear out.
        max-damage: u32,
    }
    /// All 41 slots of the player's inventory, in the order of their index;
    /// empty outside a world (API 0.1.16).
    get-slots: func() -> list<slot>;
    /// Capability `inventory-edit` (API 0.1.16): moves the item of slot
    /// `source-slot` to slot `target-slot` (hotbar, the rest of the inventory, 9 to 35, or
    /// the off hand, 40): into an empty slot, or swapping with what is
    /// there. True when the game will do it before its next tick; false
    /// without the capability, for a slot that is out of range, an armour
    /// slot, an empty source slot, or in a world another game runs.
    move-item: func(source-slot: u32, target-slot: u32) -> bool;
}

/// Capability `hotbar`: changing the selected slot, as the number keys do
/// (API 0.1.1).
interface hotbar {
    /// Selects slot 0 to 8 before the game's next tick; other values are
    /// ignored. The last call in a tick wins.
    select: func(slot: u32);
}

/// Capability `keys`: the mod's own key bindings, shown in Controls
/// (API 0.1.4). The mod names its actions; the player rebinds them.
interface keys {
    /// A key event since the last `poll`.
    record key-event {
        /// The mod's action (`map`, `waypoint`, ...), as it was bound.
        action: string,
        /// Pressed (true) or released (false).
        pressed: bool,
        /// The key repeats itself while it is held.
        repeat: bool,
    }
    /// Binds the mod's `action` to a key (`key.keyboard.m`); the player may
    /// rebind it in Controls. Binding an action twice replaces the old key.
    bind: func(action: string, default-key: string) -> result<_, string>;
    /// The key bound to the mod's `action` now (`key.keyboard.m`); none when
    /// the action is not bound or unbound by the player.
    get: func(action: string) -> option<string>;
    /// The key events since the last call; empty when nothing happened.
    poll: func() -> list<key-event>;
    /// Whether the key is held down now (`key.keyboard.left.shift`, ...): the
    /// names are the game's, as in `bind` and `options.txt`. Cheap enough
    /// to ask every frame (API 0.1.11).
    is-down: func(key: string) -> bool;
}

/// Capability `storage`: a per-mod folder of small key/value files, quota'd
/// (docs/mods.md). Keys are `[a-z0-9_.-]{1,64}`, one path segment. The folder
/// is `.horizon-mod-data/<id>` in the folder the mod is loaded from; a mod
/// that needs more than the default 4 MiB / 64 keys asks for it in its
/// manifest (`storage_quota_mib`, `storage_max_keys`). It is there in `init`.
interface storage {
    /// None if `key` has never been `set`, or the key is not well-formed.
    get: func(key: string) -> option<list<u8>>;
    /// Errs on a malformed key or over quota (bytes for the whole mod).
    set: func(key: string, value: list<u8>) -> result<_, string>;
    /// No error if `key` was already absent.
    delete: func(key: string);
    /// The mod's keys, sorted (API 0.1.5).
    list-keys: func() -> list<string>;
    /// Deprecated, API 0.1.4's name of `get`.
    read: func(name: string) -> option<list<u8>>;
    /// Deprecated, API 0.1.4's name of `set`.
    write: func(name: string, data: list<u8>) -> result<_, string>;
    /// Deprecated, API 0.1.4's name of `delete`; true when it was there.
    remove: func(name: string) -> bool;
    /// Deprecated, API 0.1.4's name of `list-keys`.
    files: func() -> list<string>;
}

/// Capability `screen`: a screen the mod draws and handles itself
/// (API 0.1.4). The game draws it over the world, without the mouse
/// grabbed, and gives it the player's input while it is open.
interface screen {
    /// The screen's size in GUI pixels.
    record size {
        width: f32,
        height: f32,
    }
    /// What to draw.
    variant shape {
        /// A filled rectangle.
        rect(rect-shape),
        /// A line of text.
        text(text-shape),
        /// An uploaded image, scaled into the rectangle.
        image(image-shape),
    }
    /// A filled rectangle.
    record rect-shape {
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        /// 0xRRGGBB.
        color: u32,
    }
    /// A line of text; (x, y) is its top left corner.
    record text-shape {
        x: f32,
        y: f32,
        text: string,
        /// 0xRRGGBB.
        color: u32,
        /// The text's shadow.
        shadow: bool,
    }
    /// An uploaded image, scaled into the rectangle.
    record image-shape {
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        /// The image's id, from `upload-texture`.
        texture: u32,
    }
    /// What the player did while the screen was open.
    variant event {
        /// A key.
        key(key-press),
        /// The mouse moved.
        mouse-move(mouse-move),
        /// A mouse button.
        mouse-button(mouse-press),
        /// The wheel.
        wheel(wheel-turn),
        /// The screen was closed.
        closed,
    }
    /// A key; `text` is the character it typed.
    record key-press {
        /// The key's name, as the game's (`key.keyboard.m`).
        key: string,
        /// Pressed (true) or released (false).
        pressed: bool,
        /// The character the key typed, when it typed one.
        text: option<string>,
    }
    /// The mouse moved; the place is in GUI pixels.
    record mouse-move {
        x: f32,
        y: f32,
    }
    /// A mouse button: 0 left, 1 right, 2 middle.
    record mouse-press {
        button: u32,
        /// Pressed (true) or released (false).
        pressed: bool,
        x: f32,
        y: f32,
    }
    /// The wheel; positive is up.
    record wheel-turn {
        steps: f32,
        x: f32,
        y: f32,
    }
    /// A point in GUI pixels (API 0.1.5).
    record point {
        x: f32,
        y: f32,
    }
    /// A rectangle in GUI pixels (API 0.1.5).
    record area {
        x: f32,
        y: f32,
        width: f32,
        height: f32,
    }
    /// The modifier keys held now (API 0.1.5).
    record modifiers {
        shift: bool,
        ctrl: bool,
        alt: bool,
    }
    /// The screen of the game itself that is open (API 0.1.5).
    enum game-screen {
        /// None: the world is being played.
        none,
        /// The player's inventory, with its 2x2 crafting grid.
        inventory,
        /// A crafting table.
        crafting,
        /// A container: a chest, a barrel, a furnace, a brewing stand, a
        /// crafter, a hopper, a dispenser.
        container,
        /// A workstation: an enchanting table, an anvil, a grindstone, a
        /// smithing table, a stonecutter, a beacon, a cartography table, a
        /// loom, a villager's trades.
        station,
        /// A mount's inventory (a horse, a donkey, a llama).
        mount,
        /// The creative inventory.
        creative,
        /// The chat.
        chat,
        /// The options.
        options,
        /// Every other screen of the game.
        other,
    }
    /// A line of a tooltip.
    record tip-line {
        text: string,
        /// 0xAARRGGBB.
        color: u32,
    }
    /// What to paint (API 0.1.5): everything `shape` draws and what a port
    /// of a Java mod's interface needs. Colours are 0xAARRGGBB.
    variant element {
        /// A rectangle, flat or a vertical gradient.
        fill(fill-element),
        /// A line of text.
        label(label-element),
        /// A sprite of the game's GUI atlas (a heart, a hunger shank, a
        /// button, an icon of the game's own), stretched into a rectangle.
        sprite(sprite-element),
        /// A part of an uploaded image.
        picture(picture-element),
        /// An item's icon, with its count and durability bar, as the
        /// inventory draws it.
        item(item-element),
        /// The game's own tooltip of an item.
        tooltip(tooltip-element),
        /// A tooltip box of the mod's own lines.
        tip(tip-element),
    }
    /// A rectangle; `top` and `bottom` are the colours of its top and
    /// bottom edges (equal: flat).
    record fill-element {
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        top: u32,
        bottom: u32,
    }
    /// A line of text; (x, y) is its top left corner.
    record label-element {
        x: f32,
        y: f32,
        text: string,
        /// 0xAARRGGBB.
        color: u32,
        shadow: bool,
        /// 1.0 is the game's size; the text grows from (x, y).
        scale: f32,
    }
    /// A sprite of the game's atlas by name: the texture's path under
    /// `assets/minecraft/textures/` without `.png` (`gui/sprites/hud/heart/full`,
    /// `gui/sprites/container/slot`, `item/apple`, ...). It is stretched
    /// into the rectangle (no nine-slice). An unknown name draws nothing.
    record sprite-element {
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        name: string,
        /// Multiplies the sprite's colour: 0xFFFFFFFF leaves it as it is,
        /// the alpha makes it translucent (the blinking of a bar).
        tint: u32,
    }
    /// A part of an image from `upload-texture` (in the full screen), in
    /// the image's own pixels, drawn into the rectangle.
    record picture-element {
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        texture: u32,
        u: f32,
        v: f32,
        u-width: f32,
        v-height: f32,
        tint: u32,
    }
    /// An item's icon (16 by 16 GUI pixels) at (x, y).
    record item-element {
        x: f32,
        y: f32,
        /// `minecraft:oak_planks`, ...; an unknown id draws nothing.
        id: string,
        /// Drawn in the corner when above 1.
        count: u32,
    }
    /// The game's own tooltip of an item, as the inventory shows it (name,
    /// stats, modifiers), its corner at (x, y), kept inside the screen;
    /// `extra` are the lines under it.
    record tooltip-element {
        x: f32,
        y: f32,
        id: string,
        count: u32,
        extra: list<tip-line>,
    }
    /// A tooltip box of lines, its corner at (x, y), kept inside the screen.
    record tip-element {
        x: f32,
        y: f32,
        lines: list<tip-line>,
    }
    /// What to paint in the next frame (API 0.1.5), after what `draw`
    /// gave; the elements of the last frame stay until the mod paints
    /// again.
    paint: func(id: u32, elements: list<element>);
    /// The width of the text in GUI pixels at the game's font (API 0.1.5);
    /// letters the game's bitmap fonts do not have count as 8.
    get-text-width: func(text: string) -> f32;
    /// Opens a panel over the game's own screen (API 0.1.5): the
    /// inventory, a container, a crafting table. The game keeps drawing
    /// and running that screen; the panel is painted over it, and the
    /// mouse is the mod's inside `area`, the game's outside. A panel is
    /// not the mod's screen: a mod may have both. It is painted only while
    /// the game has the inventory, a container, a crafting table or a
    /// station open. `keys` are the keys the mod takes instead of the game
    /// (`key.keyboard.r`, ...); `*` is every key. The mod reads the panel's
    /// input with `get-input`, like the screen's.
    open-panel: func(title: string, area: area, keys: list<string>) -> result<u32, string>;
    /// Moves or resizes the panel and changes its keys. An area of width
    /// or height 0 hides the panel.
    set-panel-area: func(id: u32, area: area, keys: list<string>);
    /// Which screen of the game is open (API 0.1.5).
    get-game-screen: func() -> game-screen;
    /// The workstation screen that is open (API 0.1.27):
    /// `minecraft:enchanting_table`, `minecraft:anvil`,
    /// `minecraft:grindstone`, `minecraft:smithing_table`,
    /// `minecraft:stonecutter`, `minecraft:beacon`,
    /// `minecraft:cartography_table`, `minecraft:loom`, `minecraft:villager`
    /// (the trades); none when no workstation screen is open.
    get-station: func() -> option<string>;
    /// The top left corner of the open screen's menu (the inventory's,
    /// the container's), in GUI pixels; none when there is no menu
    /// (API 0.1.5).
    get-menu-origin: func() -> option<point>;
    /// The item in the slot of the open screen under that point, none over
    /// no slot or an empty one (API 0.1.5).
    get-item-at: func(x: f32, y: f32) -> option<string>;
    /// Where the mouse is now, in GUI pixels (API 0.1.5).
    get-cursor: func() -> point;
    /// The modifier keys held now (API 0.1.5).
    get-modifiers: func() -> modifiers;
    /// Opens the mod's screen and returns its id; the title is shown above
    /// it. A mod has one screen: opening another closes the first.
    open: func(title: string) -> result<u32, string>;
    /// The screen's size in GUI pixels; none when it is closed.
    get-size: func(id: u32) -> option<size>;
    /// What to draw in the next frame; the shapes of the last frame stay
    /// until the mod draws again.
    draw: func(id: u32, shapes: list<shape>);
    /// What the player did since the last call; empty when nothing
    /// happened. A closed screen keeps its last events, so the mod can read
    /// the `closed` one.
    get-input: func(id: u32) -> list<event>;
    /// Closes the screen; the mod gets the `closed` event.
    close: func(id: u32);
    /// Uploads an RGBA image (`width * height * 4` bytes) under the id
    /// `id` (0 to 7); the mod draws it with an `image` shape. Uploading
    /// under the same id again replaces the image. At most 8 images of
    /// 512x512 pixels each (API 0.1.31; 256x256 before).
    upload-texture: func(id: u32, width: u32, height: u32, rgba: list<u8>) -> result<_, string>;
    /// The largest side of an image `upload-texture` takes (API 0.1.31): 512.
    get-max-texture-side: func() -> u32;
    /// How the image `id` is scaled when it is drawn (API 0.1.31):
    /// `linear` blends the four nearest pixels (smooth maps, like the Java
    /// mods' textures), `nearest` (the default) keeps hard pixels.
    set-texture-filter: func(id: u32, filter: texture-filter);
    /// How an image is scaled (API 0.1.31).
    enum texture-filter {
        nearest,
        linear,
    }
}

/// Capability `world-read`: blocks of the loaded world by position, and the
/// ones broken since the last tick (API 0.1.2). With capability
/// `world-edit` as well, breaking blocks and wearing the held item, in a
/// world this game runs (single player, or one it opened to LAN); in
/// another's world the edits do nothing and return false or none.
interface %world {
    record block-pos {
        x: s32,
        y: s32,
        z: s32,
    }
    record world-block {
        pos: block-pos,
        /// `minecraft:oak_log`, ...
        id: string,
        /// The state's properties: `axis`=`y`, `distance`=`7`,
        /// `persistent`=`false`, ...
        properties: list<tuple<string, string>>,
        /// Every block tag it is in: `minecraft:logs`, `minecraft:leaves`, ...
        tags: list<string>,
    }
    record block-broken {
        pos: block-pos,
        /// The block as it was before it broke.
        block: world-block,
        /// Broken by the player's hand or tool; false for a block a mod
        /// broke.
        by-player: bool,
        /// What the player broke it with (`minecraft:iron_axe`, ...); none
        /// for a bare hand or a block a mod broke.
        tool: option<string>,
        /// The player was sneaking as they broke it.
        sneaking: bool,
    }
    /// The block at `pos`; none where no chunk is loaded (and outside a
    /// world). Air is `minecraft:air`.
    get-block: func(pos: block-pos) -> option<world-block>;
    /// A block that got a random tick (API 0.1.12).
    record random-tick {
        pos: block-pos,
        /// The block as it is now.
        block: world-block,
    }
    /// The blocks in the watched tags that got a random tick since the
    /// previous tick, oldest first: the same positions the client's ambient
    /// effects use (667 within 16 and 32 blocks of the player,
    /// `ClientLevel.animateTick`), at most 2048 a tick. Empty until
    /// `watch-random-ticks` is called (API 0.1.12).
    random-ticked-blocks: func() -> list<random-tick>;
    /// Watches the blocks of these tags (`minecraft:leaves`): only they are
    /// reported by `random-ticked-blocks`. Calling it again replaces the
    /// earlier tags; an empty list stops the listening. Works in `init`
    /// too (API 0.1.12).
    watch-random-ticks: func(tags: list<string>);
    /// Watches blocks by id as well (API 0.1.19): `minecraft:pink_wool`, or
    /// with the state's properties it must have
    /// (`minecraft:bamboo[leaves=large]`). `random-ticked-blocks` reports
    /// these and the blocks of the watched tags. Calling it again replaces
    /// the earlier list; an empty list stops it.
    watch-random-tick-blocks: func(blocks: list<string>);
    /// A block that is gone (API 0.1.19).
    record block-removed {
        pos: block-pos,
        /// The block as it was before it went.
        block: world-block,
        /// The world took it (a leaf decayed, a block died), not the
        /// player's hand or a mod: what the player or a mod broke is in
        /// `broken-blocks` and comes here with `by-world` false.
        by-world: bool,
    }
    /// The blocks that went since the previous tick, oldest first (the
    /// blocks that became air; at most 256 a tick) (API 0.1.19).
    removed-blocks: func() -> list<block-removed>;
    /// The blocks broken since the previous tick, oldest first: the
    /// player's and those mods broke. The same list for every mod, read
    /// during `tick`.
    broken-blocks: func() -> list<block-broken>;
    /// `world-edit`: breaks the block as `Level.destroyBlock` does (its
    /// particles and sound), with its drops (its loot table without a tool)
    /// when `drops`. True when a breakable block was there. The block
    /// breaks after the call returns: until then `get-block` still sees it.
    break-block: func(pos: block-pos, drops: bool) -> bool;
    /// `world-edit`: as `break-block` with drops, the loot rolled with the
    /// item in the player's hand (Fortune, Silk Touch, the correct tool),
    /// which is not worn by it.
    break-block-with-held: func(pos: block-pos) -> bool;
    /// `world-edit`: wears the item in the player's main hand by `amount`
    /// uses (Unbreaking may spare some, as in vanilla); it may break. The
    /// durability left after the full `amount`, none when the hand holds
    /// nothing that wears or the player is in creative.
    damage-held: func(amount: u32) -> option<u32>;
    /// The surface of one chunk: what a map shows of its columns
    /// (API 0.1.4). The lists hold 256 values, in the order `z * 16 + x`.
    record chunk-surface {
        /// Each column's map colour (`MapColor`, 0 = none), as in
        /// `get-map-colors`.
        color: list<u8>,
        /// Each column's height: the Y of the topmost coloured block.
        y: list<s32>,
        /// Each column's water (or lava) depth over the surface.
        depth: list<u8>,
        /// Each column's biome, as an index in `get-biome-names`.
        biome: list<u16>,
    }
    /// The surface of the loaded chunk (cx, cz); none when the chunk is not
    /// loaded. The scan is the game's, as the minimap's is.
    get-chunk-surface: func(cx: s32, cz: s32) -> option<chunk-surface>;
    /// What a map shows of a chunk's columns beyond `chunk-surface` (API
    /// 0.1.32); the lists hold 256 values, in the order `z * 16 + x`, over
    /// the same columns `get-chunk-surface` scans.
    record chunk-details {
        /// The id of each column's top coloured block (`minecraft:grass_block`,
        /// `minecraft:red_stained_glass`, `minecraft:poppy`, ...); empty when
        /// the column has none.
        block: list<string>,
        /// Whether a block that does not hide the top block (leaves, a pane,
        /// a plant, a carpet, a snow layer) stands right on it, so the
        /// height is ambiguous as a map shows it.
        ambiguous: list<bool>,
        /// The light over each column's top block, 0 to 15: the brighter of
        /// its block light and sky light, as the world stores them.
        light: list<u8>,
    }
    /// The details of the loaded chunk (cx, cz); none when it is not loaded.
    get-chunk-details: func(cx: s32, cz: s32) -> option<chunk-details>;
    /// The world's biome names, in the order of their indexes (the ones
    /// `get-chunk-surface` gives); empty outside a world.
    get-biome-names: func() -> list<string>;
    /// How bright a place is, as the game lights it (API 0.1.20).
    record light-level {
        /// The light of blocks, 0 to 15.
        block: u32,
        /// The light of the sky, 0 to 15 (before the time of day dims it).
        sky: u32,
    }
    /// `world-read` (API 0.1.20): the light at a block; none where no chunk
    /// is loaded.
    get-light-level: func(pos: block-pos) -> option<light-level>;
    /// `world-read` (API 0.1.22): the colour of the fog of the biome at a
    /// block, 0xRRGGBB (the biome's `fog_color`, the overworld's when it has
    /// none); none where no chunk is loaded.
    get-biome-fog: func(pos: block-pos) -> option<u32>;
    /// `world-edit` (API 0.1.20): runs a command as the player typed it,
    /// without the slash, after the hook. False when the command is empty,
    /// the mod has no `world-edit` or the world is not this game's own.
    run-command: func(command: string) -> bool;
    /// `world-edit` (API 0.1.23): after the hook, moves the items and the
    /// experience that blocks broken lately by `break-block` dropped (the
    /// last few ticks, within 16 blocks of `pos`) to the middle of the block
    /// at `pos`. False in a world this game does not run.
    merge-drops-at: func(pos: block-pos) -> bool;
    /// `world-edit` (API 0.1.24): takes the block at `pos` out of the world
    /// and makes it fall as a falling block with that velocity (blocks per
    /// tick), after the hook. `drops`: the loot the block gives to the held
    /// item falls out where it stood. `place`: where it lands it stays a
    /// block, or, when it cannot be placed there (another block is in the
    /// way), drops as an item like vanilla's falling blocks; false: it
    /// vanishes there. False when no breakable block is at
    /// `pos` or the world is not this game's own.
    fall-block: func(pos: block-pos, vx: f64, vy: f64, vz: f64, drops: bool, place: bool) -> bool;
    /// `world-edit` (API 0.1.24): puts the block `id` (`minecraft:oak_log`)
    /// at `pos` with those properties (`axis` = `y`); the ones not given
    /// are the default state's. The neighbours are updated as for a command's
    /// `setblock`. False for an unknown block or a bad property, no loaded
    /// chunk, or a world this game does not run; at most 64 a hook.
    set-block: func(pos: block-pos, id: string, properties: list<tuple<string, string>>) -> bool;
    /// `world-edit` (API 0.1.24): lets an item fall out at `pos`, the way
    /// an item comes out of a broken block, after the hook. False for an
    /// unknown item or a count of 0 or more than 64; at most 64 a hook.
    spawn-item: func(pos: block-pos, id: string, count: u32) -> bool;
    /// `world-read` (API 0.1.25): the blocks the mod's colliding particles
    /// fly through: ids (`minecraft:oak_fence`) and tags (`#minecraft:fences`).
    /// Replaces the mod's earlier list; an empty list lets them hit every
    /// block that stops a particle.
    set-weather-passthrough: func(blocks: list<string>);
    /// The colours of the map (`MapColor`) by id, as 0xRRGGBB; the id is
    /// the one `get-chunk-surface` gives. Empty outside a world.
    get-map-colors: func() -> list<u32>;
    /// As `get-chunk-surface`, but the scan goes down from the height `y`
    /// instead of the top of the chunk: the highest block with a map colour
    /// at `y` or below, for a cave map (API 0.1.7).
    get-chunk-columns: func(cx: s32, cz: s32, y: s32) -> option<chunk-surface>;
    /// A biome as a mod reads it (API 0.1.6).
    record biome {
        /// `minecraft:desert`, ...
        id: string,
        /// `Biome.getBaseTemperature`.
        temperature: f32,
        /// `Biome.hasPrecipitation`: it gets rain or snow at all.
        precipitation: bool,
        /// How much precipitation falls in it (`downfall`).
        downfall: f32,
        /// The foliage colour 0xRRGGBB (`FoliageColor`), the grass colour
        /// (`GrassColor`, before a grass modifier) and the water colour.
        foliage: u32,
        grass: u32,
        water: u32,
    }
    /// The biome at `pos`; none where no chunk is loaded (API 0.1.6).
    get-biome: func(pos: block-pos) -> option<biome>;
    /// Where the ground is in the column of `pos`: the y of the first free
    /// space above the first block that stops motion (solid, leaves or a
    /// fluid) found going down from `start-y` (`Heightmap.MOTION_BLOCKING`'s
    /// idea); none where no chunk is loaded (API 0.1.6).
    get-surface: func(pos: block-pos, start-y: s32) -> option<s32>;
    /// Whether the block at `pos` has a full collision box (API 0.1.6).
    is-solid: func(pos: block-pos) -> bool;
    /// One stack in a container (API 0.1.9).
    record container-stack {
        /// `minecraft:stone`, ...
        id: string,
        count: u32,
        /// The durability used; 0 for an item that does not wear out.
        damage: u32,
    }
    /// The items of the container at `pos` (a chest, a barrel, a shulker box,
    /// a hopper, a dropper, a dispenser, a crafter; a furnace, a blast
    /// furnace or a smoker: input, fuel, result), in slot order, an empty slot
    /// none. Only for the block the player looks at or is breaking, in a
    /// world this game runs or whose contents the game knows; none for any
    /// other position or block (API 0.1.9).
    get-container: func(pos: block-pos) -> option<list<option<container-stack>>>;

    /// What a block entity keeps (API 0.1.35).
    record block-entity {
        /// What it is: `minecraft:beehive`, `minecraft:jukebox`,
        /// `minecraft:lectern`, `minecraft:mob_spawner`, `minecraft:sign`,
        /// `minecraft:command_block`, ...
        id: string,
        /// The same slots as `get-container` (empty for a block entity
        /// that is not a container).
        items: list<option<container-stack>>,
        /// The bees inside a beehive or a bee nest.
        bees: u32,
        /// The record in a jukebox (`minecraft:music_disc_cat`).
        jukebox-record: option<string>,
        /// The book on a lectern (its item id).
        book: option<string>,
        /// A spawner's first entity (`minecraft:zombie`).
        spawner-entity: option<string>,
        /// A spawner's ticks to the next spawn.
        spawner-cooldown: u32,
        /// A command block's command.
        command: option<string>,
        /// The four lines of a sign's front, empty for the other blocks.
        sign-lines: list<string>,
        /// A sign is waxed.
        waxed: bool,
    }
    /// The block entity at `pos`, as `get-container`: the block the player
    /// looks at or is breaking, a world this game runs or whose contents
    /// the game knows; none for another position or a block without one
    /// (API 0.1.35; `world-read`). A superset of `get-container`.
    get-block-entity: func(pos: block-pos) -> option<block-entity>;
}

/// Capability `items-read`: the items of the game, vanilla's and the content
/// mods' (API 0.1.5).
interface items {
    record item {
        /// `minecraft:oak_planks`, ...
        id: string,
        /// Its name in the game's language; the id when it has none.
        name: string,
        /// The stack size: 64 for most items, 1 for tools and armour.
        max-stack: u32,
        /// Every tag it is in, as full names without `#`.
        tags: list<string>,
    }
    /// Every item of the game, in the order of the creative inventory's
    /// search tab.
    %list: func() -> list<item>;
    /// One item by id; none for an unknown id.
    get: func(id: string) -> option<item>;
    /// The colour the game shows the item's name in (API 0.1.20), 0xRRGGBB:
    /// by its rarity, white for common, yellow, aqua or light purple above.
    /// None for an unknown id.
    get-name-color: func(id: string) -> option<u32>;
    /// One line of an item's tooltip (API 0.1.35).
    record tooltip-line {
        text: string,
        /// 0xAARRGGBB.
        color: u32,
    }
    /// The tooltip lines of one item by id, as the game draws a plain
    /// stack of it (the name in its rarity's colour, then the lines the
    /// game adds); empty for an unknown id (API 0.1.35; `items-read`).
    get-tooltip: func(id: string) -> list<tooltip-line>;
}

/// Capability `recipes-read`: the recipes of the game, vanilla's and the
/// content mods' (API 0.1.5). The recipes that run code (dyeing, copying a
/// map) have no fixed slots and are not listed.
interface recipes {
    enum kind {
        crafting-shaped,
        crafting-shapeless,
        smelting,
        blasting,
        smoking,
        campfire-cooking,
        stonecutting,
        smithing-transform,
        smithing-trim,
    }
    record recipe {
        kind: kind,
        /// The block it is made at, as an item id: `minecraft:crafting_table`,
        /// `minecraft:furnace`, ...
        station: string,
        /// The slots that take items, one list per slot: the items it
        /// accepts (one item, or the items of a tag or a list). A crafting
        /// recipe's are the grid's cells in row order, the empty ones as
        /// empty lists (shapeless: 2 wide for up to 4 ingredients, else 3
        /// wide); cooking and stonecutting have one slot, smithing three
        /// (template, base, addition).
        inputs: list<list<string>>,
        /// The item made (the recipe's result); none for a trim, which keeps
        /// its base.
        output: option<string>,
        /// How many of the result it makes.
        count: u32,
        /// A crafting recipe's grid; 0 for the other kinds.
        width: u32,
        height: u32,
        /// A cooking recipe's time in ticks and the experience it gives.
        time: u32,
        experience: f32,
    }
    /// Every recipe of the game.
    %list: func() -> list<recipe>;
    /// The recipes that make the item (API 0.1.35; `recipes-read`).
    get-for: func(item: string) -> list<recipe>;
    /// The recipes that take the item in a slot (API 0.1.35).
    get-uses: func(item: string) -> list<recipe>;
}

/// Capability `weather-read`: the weather over the player (API 0.1.6).
interface weather {
    record state {
        /// 0 to 1: how hard it rains (`Level.getRainLevel`).
        rain: f32,
        /// 0 to 1: how hard the thunderstorm is (`Level.getThunderLevel`).
        thunder: f32,
    }
    /// The weather over the player; none outside a world and in a dimension
    /// that has none.
    get-weather: func() -> option<state>;
    /// Whether the game draws its own rain and snow columns (API 0.1.22).
    /// A mod that draws the weather with its own particles turns them off;
    /// they stay off while any running mod says so, and come back when the
    /// mod says `true` or stops.
    set-default-weather: func(visible: bool);
    /// Whether the game draws its own rain splashes on the ground (API
    /// 0.1.25). A mod that draws its own splashes turns them off; they stay
    /// off while any running mod says so. Smoke over lava and campfires
    /// stays.
    set-default-splashing: func(visible: bool);
}

/// Capability `settings-read`: the client's own settings (API 0.1.6).
interface settings {
    /// The Particles setting: 0 all, 1 decreased, 2 minimal.
    get-particles: func() -> u32;
}

/// Capability `particles`: the mod's own particles with its own pictures
/// (API 0.1.6).
interface particles {
    /// A picture the mod's particles are drawn with.
    record sprite {
        /// The mod's own name for it (`rain_drop`); the same name replaces
        /// the old picture.
        name: string,
        /// 1 to 64 pixels.
        width: u32,
        height: u32,
        /// RGBA, four bytes a pixel, row by row from the top left.
        pixels: list<u8>,
    }
    /// A colour, each part 0 to 1; white leaves the picture's own colours.
    record color {
        r: f32,
        g: f32,
        b: f32,
        a: f32,
    }
    /// How the particle's size changes as it lives.
    enum size-curve {
        /// The same size the whole time.
        constant,
        /// Grows from a third of its size to its size.
        grow,
        /// Shrinks to nothing.
        shrink,
    }
    /// How the particle fades out.
    enum fade {
        /// It stays as bright as it is.
        none,
        /// It fades at the end of its life, as vanilla's particles do.
        late,
        /// It fades over its whole life.
        full,
    }
    /// One particle.
    record options {
        /// The picture (the number `define-sprite` gave).
        sprite: u32,
        /// Where it starts, in blocks.
        x: f64,
        y: f64,
        z: f64,
        /// How fast it moves at the start, in blocks per tick.
        vx: f64,
        vy: f64,
        vz: f64,
        color: color,
        /// The width of its quad, in blocks.
        size: f32,
        /// How long it lives, in ticks (1 to 1200).
        lifetime: u32,
        /// The downward speed it gains every tick.
        gravity: f32,
        /// The sideways speed (x and z, blocks per tick) it is pulled
        /// towards: the wind. 0 and 0 leaves its own.
        wind-x: f64,
        wind-z: f64,
        /// Whether it stops at the blocks and fluids it hits (and is then
        /// reported by `landed`).
        collide: bool,
        size-curve: size-curve,
        fade: fade,
        /// Whether it lies flat (a ring on the water).
        flat: bool,
        /// How many ticks it lies where it landed before it vanishes.
        linger: u32,
        /// How far it sways sideways, in blocks per tick at most (0: no
        /// sway), and how many ticks a sway takes (at least 1).
        sway: f32,
        sway-period: u32,
        /// How fast it turns about its own axis and about a horizontal one,
        /// in radians per tick.
        spin: f32,
        tumble: f32,
    }
    /// Where one of the mod's colliding particles landed.
    record landing {
        /// The picture of the particle that landed.
        sprite: u32,
        x: f64,
        y: f64,
        z: f64,
        /// It hit a fluid (the point is on its surface), not a solid block
        /// (the point is on the block's top).
        water: bool,
    }
    /// Adds a picture and gives its number; an error when it is refused (too
    /// big, wrong size of pixels, no room: 16 pictures in all, shared by
    /// the mods).
    define-sprite: func(sprite: sprite) -> result<u32, string>;
    /// Spawns one particle; false when it was refused (an unknown picture,
    /// or more than 512 particles in this call). At most a few thousand of
    /// the mods' particles live at once.
    spawn: func(options: options) -> bool;
    /// How a particle's picture is turned (API 0.1.22).
    enum rotation {
        /// Faces the camera (what `spawn` does).
        camera,
        /// Turns about the view axis so that the picture's up points along
        /// the particle's velocity as the camera sees it: a raindrop's
        /// streak leans with the wind.
        relative-velocity,
        /// Keeps the camera's orientation and ignores `spin` and `tumble`.
        copy-camera,
        /// Stands upright in a vertical plane that turns to face the camera
        /// about the vertical axis only (a sheet of fog).
        vertical,
        /// Two upright quads crossing at right angles, the model of a plant
        /// like `minecraft:dead_bush`: the picture is the plant's texture
        /// (from `get-game-sprite`), `spin` turns it about the vertical axis
        /// and `tumble` over about a horizontal one (API 0.1.25).
        crossed,
    }
    /// As `spawn`, with the way the picture is turned (API 0.1.22).
    spawn-rotated: func(options: options, rotation: rotation) -> bool;
    /// How a particle is drawn (API 0.1.30).
    enum render-type {
        /// Drawn solid: its colour's alpha and fade are ignored.
        opaque,
        /// Drawn with its alpha (the default of `spawn`).
        translucent,
        /// Drawn with its alpha, as a glow; the game has no additive pass
        /// yet, so it looks like `translucent`.
        blended,
    }
    /// What `spawn-styled` adds to `options` and `rotation` (API 0.1.30).
    record style {
        /// A colliding particle that lands fast enough bounces back up with
        /// this share of its speed (0 = it lands, as before).
        bounciness: f32,
        render-type: render-type,
        /// 0: the size of a particle follows the perspective; 1: it keeps the
        /// size it has 8 blocks away, whatever its distance (a constant size
        /// on the screen); between, a mix.
        distance-scaling: f32,
    }
    /// As `spawn-rotated`, with a style.
    spawn-styled: func(options: options, rotation: rotation, style: style) -> bool;
    /// One of the mod's own living particles (API 0.1.25).
    record particle {
        /// The picture's number, as `spawn` took it.
        sprite: u32,
        x: f64,
        y: f64,
        z: f64,
        vx: f64,
        vy: f64,
        vz: f64,
        /// How many ticks it still lives.
        remaining: u32,
    }
    /// The mod's own particles that live now, as of the last tick (at most
    /// 4096); empty when the mod has none.
    get-particles: func() -> list<particle>;
    /// Removes the mod's own particles with the picture number `sprite`
    /// that are within a block of (`x`, `y`, `z`) (API 0.1.26). They are
    /// gone after the hook. How many of the particles `get-particles`
    /// listed match.
    remove: func(sprite: u32, x: f64, y: f64, z: f64) -> u32;
    /// The mod's own particles that landed since the last call, oldest first.
    landed: func() -> list<landing>;
    /// A picture of the game's block, item or GUI atlas (API 0.1.19).
    record game-image {
        width: u32,
        height: u32,
        /// RGBA, four bytes a pixel, row by row from the top left, as
        /// `define-sprite` takes it.
        pixels: list<u8>,
    }
    /// The picture of a sprite of the game's block atlas
    /// (`minecraft:block/oak_leaves`), as the enabled resource packs give
    /// it, or none when there is no such sprite. A mod draws its particles
    /// with it by giving the pixels to `define-sprite` (API 0.1.19).
    get-game-sprite: func(name: string) -> option<game-image>;
    /// The particles of the game that the mod silences or scales (API
    /// 0.1.19): their ids (`minecraft:tinted_leaves`, `minecraft:cherry_leaves`,
    /// `minecraft:pale_oak_leaves`) and a multiplier of the chance with
    /// which the game's blocks spawn them (0: none). The list replaces the
    /// mod's earlier one; with several mods the smallest multiplier wins;
    /// it ends with the mod. Only particles the game spawns from blocks
    /// by chance (falling leaves) can be scaled.
    set-suppressed: func(types: list<string>, scale: f32);
    /// Makes `/particle <mod id>:<name>` spawn this particle (API 0.1.19):
    /// `options` are the template (its position is where the command puts
    /// it, its velocity the command's delta), and the picture must have
    /// been defined before. An error for a bad name; the same name
    /// replaces the old one.
    register-command-particle: func(name: string, options: options) -> result<_, string>;
}

/// Capability `atmosphere`: the mod's own weather in the fog (API 0.1.6).
interface atmosphere {
    record haze {
        /// 0 to 1: how much of the fog's colour the haze takes.
        amount: f32,
        /// The colour it takes, each part 0 to 1.
        red: f32,
        green: f32,
        blue: f32,
        /// How much closer the fog comes: its end distance times
        /// `1 - density` (0 to 0.9).
        density: f32,
    }
    /// The haze of the mod; none for none. The game keeps it until the mod
    /// sets it again and drops it when the mod stops. With several mods the
    /// strongest haze counts.
    set-haze: func(haze: option<haze>);
}

/// Capability `overlay`: the mod's own graphics over the world, in the HUD's
/// layer, without taking the mouse or the keyboard (API 0.1.7). It draws the
/// elements `screen.paint` does.
interface overlay {
    use screen.{element, size};
    /// Where in the HUD an element goes.
    enum layer {
        /// Before the game draws its status bars (health, hunger, armour,
        /// air, experience): the bars are drawn over it.
        under-bars,
        /// After them, over every other part of the HUD but the chat and the
        /// screens.
        over-bars,
    }
    /// A point of the world with a picture drawn at it (a waypoint).
    variant world-element {
        label(world-label),
        sprite(world-sprite),
        fill(world-fill),
        /// A part of an image from `upload-texture` (API 0.1.20).
        picture(world-picture),
        /// The edges of a block-sized box in the world (API 0.1.23).
        box(world-box),
    }
    /// The twelve edges of a box 1 by 1 by 1 around a point, as the game
    /// draws a block outline.
    record world-box {
        /// The middle of the box.
        x: f64,
        y: f64,
        z: f64,
        /// 0xAARRGGBB.
        color: u32,
        /// The line's width in pixels.
        width: f32,
        /// Drawn over the blocks, not hidden by them.
        through-blocks: bool,
    }
    /// A part of an image of `upload-texture` drawn at a point of the
    /// world, its middle at the point.
    record world-picture {
        x: f64,
        y: f64,
        z: f64,
        width: f32,
        height: f32,
        /// The image's id.
        texture: u32,
        /// The part of the image, in the image's pixels.
        u: f32,
        v: f32,
        u-width: f32,
        v-height: f32,
        /// 0xAARRGGBB multiplying the image's colours.
        tint: u32,
        offset-y: f32,
    }
    /// A line of text drawn at a point of the world, always facing the
    /// camera, at a size that does not change with the distance. Its
    /// middle is at the point, `offset-y` GUI pixels down.
    record world-label {
        x: f64,
        y: f64,
        z: f64,
        text: string,
        /// 0xAARRGGBB.
        color: u32,
        shadow: bool,
        scale: f32,
        offset-y: f32,
    }
    /// A sprite of the GUI atlas drawn at a point of the world, its middle
    /// at the point.
    record world-sprite {
        x: f64,
        y: f64,
        z: f64,
        width: f32,
        height: f32,
        name: string,
        /// 0xAARRGGBB.
        tint: u32,
        offset-y: f32,
    }
    /// A filled rectangle drawn at a point of the world, its middle at the
    /// point.
    record world-fill {
        x: f64,
        y: f64,
        z: f64,
        width: f32,
        height: f32,
        /// 0xAARRGGBB.
        color: u32,
        offset-y: f32,
    }
    /// What the HUD is doing.
    record hud-state {
        /// A screen (the inventory, the chat, the pause menu) is open.
        screen-open: bool,
        /// The debug screen (F3) is on.
        debug: bool,
        /// The HUD is hidden (F1).
        hidden: bool,
    }
    /// What to paint in a layer in the next frames; the elements of the last
    /// call stay until the mod paints again or clears. `picture` elements
    /// use the images of `upload-texture`.
    paint: func(layer: layer, elements: list<element>);
    /// Removes what the mod painted in the layer.
    clear: func(layer: layer);
    /// What to draw at points of the world; stays until the next call.
    /// The game projects the points with the camera of the last frame and
    /// leaves out those behind it.
    paint-world: func(elements: list<world-element>);
    /// Removes what the mod drew in the world.
    clear-world: func();
    /// The screen's size in GUI pixels; none when the game has no window.
    get-size: func() -> option<size>;
    /// The width of the text in GUI pixels at the game's font.
    get-text-width: func(text: string) -> f32;
    /// Uploads an RGBA image (`width * height * 4` bytes) under the id `id`
    /// (0 to 6); it is drawn by `picture` elements of the overlay. At most
    /// 7 images of 256x256 pixels shared by all the mods' overlays.
    upload-texture: func(id: u32, width: u32, height: u32, rgba: list<u8>) -> result<_, string>;
    /// What the HUD is doing; none outside a world.
    get-hud-state: func() -> option<hud-state>;
    /// The player list (Tab) is open (API 0.1.34; `overlay`). A separate
    /// function: `hud-state` is a published record.
    is-tab-list-open: func() -> bool;
}

/// Capability `entity-read`: the entities around the player (API 0.1.8). With
/// capability `entity-edit` as well, removing entities and changing what an
/// experience orb is worth, in a world this game runs (single player, or one
/// it opened to LAN); in another's world the edits do nothing and return
/// false. What the game keeps of the other world's entities is what the
/// server told it.
interface %entity {
    /// What an entity is.
    enum entity-kind {
        /// A mob (a zombie, a cow, a villager, an armour stand).
        mob,
        /// An item lying in the world.
        item,
        /// A player other than the local one.
        player,
        /// Everything else: an experience orb, an arrow, a boat.
        other,
    }
    /// One entity.
    record entity {
        /// Its id in the world, as of the last tick.
        id: u32,
        /// `minecraft:zombie`, `minecraft:item`, `minecraft:experience_orb`, ...
        type-id: string,
        kind: entity-kind,
        /// Its name in the game's language (its custom name when it has one);
        /// an item's is the item's.
        name: string,
        /// A player's UUID; empty for the others.
        uuid: string,
        /// Where it is, as of the last tick, in blocks.
        x: f64,
        y: f64,
        z: f64,
        /// Where it faces, in degrees.
        yaw: f32,
        /// Its height in blocks.
        height: f32,
        /// Its health when it has one; 0 for an entity without.
        health: f32,
        max-health: f32,
        /// What an experience orb is worth; 0 for every other entity.
        xp: u32,
        /// It is burning.
        on-fire: bool,
        /// A mob that attacks the player (the game's monster category).
        hostile: bool,
        /// What it holds in its main hand and its off hand; an item's own
        /// item in `held-item`.
        held-item: option<string>,
        off-hand-item: option<string>,
    }
    /// A player's face as an image.
    record face {
        width: u32,
        height: u32,
        /// `width * height * 4` bytes, RGBA.
        rgba: list<u8>,
    }
    /// The entities of the kind (`minecraft:experience_orb`, ...) within
    /// `radius` blocks of the player (at most 512 blocks); every kind when
    /// `type-id` is empty. The nearest first, at most 1024. Empty outside a
    /// world.
    nearby: func(type-id: string, radius: f64) -> list<entity>;
    /// `entity-edit`: removes the entity with that id; false when there is
    /// no such entity or the world is not this game's.
    remove: func(id: u32) -> bool;
    /// `entity-edit`: sets what an experience orb is worth; false for
    /// another entity or a world this game does not run.
    set-xp: func(id: u32, xp: u32) -> bool;
    /// The face of the player with that UUID (the 8 by 8 face and hat of
    /// the skin); none when the game has no skin of theirs. None for now
    /// for every UUID: the skins are not given to mods yet.
    get-face: func(uuid: string) -> option<face>;

    /// The extra state of one entity (API 0.1.20), as of the last tick.
    record detail {
        /// A creeper's fuse: 0 when it is not about to explode, up to 1
        /// when it is (`Creeper.getSwelling`); primed TNT's fuse the same
        /// way (1 at the start, 0 at the blast).
        swell: f32,
        /// It has the Glowing effect.
        glowing: bool,
        /// Its eyes are in water (`Entity.wasEyeInWater`).
        in-water: bool,
        /// How much a cube mob (a slime, a magma cube) is squished, 0 or
        /// more; 0 for the others.
        squish: f32,
        /// How many ticks a glow squid has left to glow; 0 when it glows
        /// fully. The game does not track it, so always 0 for now.
        dark-ticks: u32,
        /// The block an enderman carries, empty when it carries none.
        carried-block: string,
    }
    /// The state of the entity with that id (API 0.1.20; `entity-read`);
    /// none for an id `nearby` did not list.
    get-detail: func(id: u32) -> option<detail>;

    /// One entity type of the game's registry (API 0.1.33).
    record type-info {
        /// The registry key, e.g. `minecraft:creeper`.
        id: string,
        /// The display name from the language files (`entity.<ns>.<path>`),
        /// empty when the language has none.
        name: string,
        /// The entity tags the type is in, full names without `#`
        /// (`minecraft:skeletons`), sorted.
        tags: list<string>,
    }
    /// Every entity type of the registry, sorted by id (API 0.1.33;
    /// `entity-read`). `BuiltInRegistries.ENTITY_TYPE`, not only the types
    /// that were seen near the player.
    get-types: func() -> list<type-info>;
    /// Whether the entity with that id is invisible (`Entity.isInvisible`:
    /// the Invisibility effect or the invisible flag), as of the last tick
    /// (API 0.1.33; `entity-read`); false for an id `nearby` did not list.
    /// A separate function: `detail` is a published record and stays as it is.
    is-invisible: func(id: u32) -> bool;

    /// More state of one entity (API 0.1.35).
    record entity-extra {
        /// A baby (`AgeableMob.isBaby`: a baby zombie, a calf, ...).
        baby: bool,
        /// `AgeableMob.getAge`: negative while a baby grows up, 0 or more
        /// for an adult's breeding cooldown; 0 for the others.
        age: s32,
        /// `Animal.isInLove`.
        in-love: bool,
        /// A villager's or zombie villager's profession key
        /// (`minecraft:farmer`); empty for the others.
        profession: string,
        /// A villager's level, 1 to 5; 0 for the others.
        profession-level: u32,
        /// A horse's jump strength (the base value); 0 for the others.
        horse-jump: f32,
        /// A horse's movement speed (the base value); 0 for the others.
        horse-speed: f32,
        /// The armour a wolf or a horse wears; none when it wears none.
        pet-armor: option<string>,
        /// The owner of a tamed animal as the UUID in 32 hexadecimal
        /// characters; none when it has none.
        owner: option<string>,
        /// Head, chest, legs, feet, main hand and off hand; none for an
        /// empty slot.
        equipment: list<option<string>>,
        /// An item frame's item and rotation (0 to 7); none and 0 for the
        /// others.
        frame-item: option<string>,
        frame-rotation: u32,
        /// A painting's motive (`minecraft:kebab`) and its size in blocks;
        /// none and 0 for the others.
        painting-motive: option<string>,
        painting-width: u32,
        painting-height: u32,
        /// The block a falling block is (`minecraft:sand`).
        falling-block: option<string>,
        /// The count of an item entity's stack; 0 for the others.
        item-count: u32,
    }
    /// The extra state of the entity with that id, as of the last tick;
    /// none for an id `nearby` did not list, and for the entities farther
    /// than the 64 nearest (API 0.1.35; `entity-read`).
    get-extra: func(id: u32) -> option<entity-extra>;
    /// The loot table of the entity with that id (`minecraft:entities/zombie`);
    /// none for an id `nearby` did not list and for an entity without one
    /// (API 0.1.35; `entity-read`).
    get-loot-table: func(id: u32) -> option<string>;
    /// The width of the entity's box (`Entity.getBbWidth`); 0 for an id
    /// `nearby` did not list (API 0.1.35; `entity-read`).
    get-width: func(id: u32) -> f32;
    /// The mob is fully frozen (`LivingEntity.isFullyFrozen`: 140 ticks in
    /// powder snow); false for an id `nearby` did not list (API 0.1.35;
    /// `entity-read`).
    is-frozen: func(id: u32) -> bool;
}

/// Capabilities `slots-read` and `slot-decorate`: the game's own slots, the
/// one under the cursor, and the marks the mod has the game draw on them
/// (API 0.1.10).
interface slots {
    /// What to draw on a slot: 16 by 16 GUI pixels where an item is.
    variant mark-shape {
        /// A frame one pixel thick around the slot.
        frame(frame-mark),
        /// A square in the slot's top right corner.
        dot(dot-mark),
        /// The whole slot filled (a highlight).
        fill(fill-mark),
        /// The mod's own picture on the slot (API 0.1.20).
        picture(picture-mark),
        /// A square wherever in the slot (API 0.1.20).
        square(square-mark),
    }
    /// A picture of the mod on a slot, drawn over the item. The images are
    /// those of `upload-texture` (the same as `overlay.upload-texture`'s).
    record picture-mark {
        /// The image's id, 0 to 6.
        texture: u32,
        /// The size it is drawn at, in GUI pixels.
        width: f32,
        height: f32,
        /// Where its top left corner goes in the slot, in GUI pixels (0, 0
        /// is the slot's top left corner; the slot is 16 by 16).
        x: f32,
        y: f32,
        /// 0xAARRGGBB multiplying the image's colours; white as it is.
        color: u32,
    }
    /// A square in a chosen place of the slot.
    record square-mark {
        /// 0xAARRGGBB.
        color: u32,
        /// The side in GUI pixels.
        size: f32,
        x: f32,
        y: f32,
    }
    record frame-mark {
        /// 0xAARRGGBB.
        color: u32,
    }
    record dot-mark {
        /// 0xAARRGGBB.
        color: u32,
        /// The side of the square in GUI pixels.
        size: f32,
    }
    record fill-mark {
        /// 0xAARRGGBB.
        color: u32,
    }
    /// A mark on one of the game's slots.
    record mark {
        /// The slot's id: 0 to 8 the hotbar (on the HUD, in the inventory and
        /// in the creative inventory's item tab), 9 to 35 the rest of the
        /// inventory, 100 to 108 the crafting grid, 200 the crafting result,
        /// 300 and up a container's slots, 500 to 503 the armour (head to
        /// feet), 504 the off hand.
        slot: u32,
        shape: mark-shape,
    }
    /// `slot-decorate`: the marks the game draws on its slots, in the HUD's
    /// hotbar and in the open screen with slots; a mark of a slot that is not
    /// on screen is kept and not drawn. They stay until the mod sets them
    /// again (an empty list clears them), and go when the mod stops. At most
    /// 256 marks.
    set-marks: func(marks: list<mark>);
    /// `slot-decorate` (API 0.1.20): marks drawn only on the slots of the
    /// open screen, in addition to those of `set-marks`.
    set-screen-marks: func(marks: list<mark>);
    /// `slot-decorate` (API 0.1.20): marks drawn only on the hotbar of the
    /// HUD, in addition to those of `set-marks`.
    set-hud-marks: func(marks: list<mark>);
    /// `slot-decorate` (API 0.1.20): an image for `picture` marks; the
    /// store is the one of `overlay.upload-texture` (the same ids, at most
    /// 7 images of 256 by 256 pixels).
    upload-texture: func(id: u32, width: u32, height: u32, rgba: list<u8>) -> result<_, string>;
    /// `slots-read`: the slot under the cursor in the open screen with slots
    /// (the inventory, a container); none otherwise.
    get-hovered-slot: func() -> option<u32>;
}

/// Capability `tooltip`: what the mod adds to the tooltip the game draws for
/// an item (API 0.1.11).
interface tooltip {
    use screen.{element, tip-line};
    /// The item whose tooltip the game drew in the last frame (inventory,
    /// containers, the creative inventory, the workstation screens), with the tooltip's frame.
    record hovered {
        /// `minecraft:cooked_beef`, ...
        item: string,
        /// The frame in GUI pixels.
        x: f32,
        y: f32,
        width: f32,
        height: f32,
    }
    /// What the mod adds under the tooltip's text: the room it takes and
    /// what is drawn in it. The elements' positions are from the top left
    /// of that room; `picture` elements use the images of
    /// `overlay.upload-texture`.
    record content {
        width: f32,
        height: f32,
        elements: list<element>,
    }
    /// The item the game drew a tooltip for in the last frame; none when
    /// the cursor was over none.
    get-hovered: func() -> option<hovered>;
    /// What to add to the tooltip of the item (all stacks of that item id);
    /// none removes it. It stays until the mod changes it, and goes with
    /// the mod. Up to 32 items, 128 elements each, and 256 by 256 pixels.
    set-content: func(item: string, content: option<content>);

    /// An enchantment of the item the tooltip is for (API 0.1.27).
    record enchantment {
        /// `minecraft:sharpness`, ...
        id: string,
        /// Its level.
        level: u32,
        /// Stored in the item (an enchanted book) rather than on it.
        stored: bool,
    }
    /// A line a mod adds into the text of an item's tooltip (API 0.1.27).
    record line {
        /// The translation key of the game's line the new one goes right
        /// under: `enchantment.minecraft.sharpness` for the line of that
        /// enchantment. Empty: under the last line. A line whose key is not
        /// in the tooltip is not drawn.
        under: string,
        /// What the line says.
        text: string,
        /// 0xAARRGGBB.
        color: u32,
    }
    /// The enchantments of the item the game drew a tooltip for in the last
    /// frame, in the order of the tooltip (the stored ones first); empty
    /// when the cursor was over no item (API 0.1.27).
    get-hovered-enchantments: func() -> list<enchantment>;
    /// The lines this mod adds to the tooltip of the item under the cursor
    /// (API 0.1.27); they stay until the mod changes them and go with the
    /// mod. Up to 64 lines of 256 characters. Lines of several mods are
    /// drawn in the order of the mods' ids.
    set-lines: func(lines: list<line>);

    /// One item of a container (API 0.1.28).
    record container-item {
        /// `minecraft:stone`, ...
        id: string,
        count: u32,
        /// The durability used; 0 for an item that does not wear out.
        damage: u32,
    }
    /// A stack with what is in it (API 0.1.28).
    record hovered-stack {
        /// `minecraft:red_shulker_box`, ...
        item: string,
        count: u32,
        damage: u32,
        /// The items of the stack's `minecraft:container` component by slot
        /// (27 slots or more); an empty slot is none. Empty for a stack
        /// without the component.
        container: list<option<container-item>>,
    }
    /// The stack the game drew a tooltip for in the last frame, with what is
    /// in it; none when the cursor was over none (API 0.1.28).
    get-hovered-stack: func() -> option<hovered-stack>;
    /// A tooltip of the mod's own for one stack (API 0.1.28).
    record hovered-tooltip {
        /// The lines of the tooltip in place of the game's own (the first
        /// is the name); none keeps the game's lines (and the mod's
        /// `set-lines`).
        lines: option<list<tip-line>>,
        /// The room under the lines and what is drawn in it, from the top
        /// left of that room.
        width: f32,
        height: f32,
        elements: list<element>,
    }
    /// The mod's own tooltip for the stack it last read with
    /// `get-hovered-stack`; none gives the game's tooltip back. The game
    /// shows it only while it draws a tooltip for that same stack (the
    /// same item, count, damage and contents), so a mod sets it in
    /// `frame` right after reading the stack; for another stack the game's
    /// own tooltip is drawn. It goes with the mod.
    set-hovered-tooltip: func(tooltip: option<hovered-tooltip>);
}

/// Capability `resource-read`: the files of the enabled resource packs, as
/// the game merges them (API 0.1.14).
interface resources {
    /// The namespaces the packs have files for: `minecraft` and the packs'
    /// own, sorted.
    namespaces: func() -> list<string>;
    /// The files under `assets/<namespace>/<prefix>`, as paths relative to
    /// `assets/<namespace>/` (`optifine/ctm/glass/0.properties`,
    /// `textures/block/glass.png`), sorted; an empty prefix lists all. At
    /// most 20000.
    list-files: func(namespace: string, prefix: string) -> list<string>;
    /// A file's bytes (up to 32 MiB); none when there is no such file.
    read-file: func(namespace: string, path: string) -> option<list<u8>>;
    /// The pack the file comes from, as the game merged them: `vanilla`
    /// for the game's own file, the pack's id (`file/my_pack`) for a file a
    /// pack gave or replaced; none when there is no such file (API 0.1.17).
    file-origin: func(namespace: string, path: string) -> option<string>;
}

/// Capability `texture-rules`: what the faces of blocks show (API 0.1.14).
/// The mod gives pictures and rules; the mesher applies them to each face it
/// draws, so no mod code runs per face.
interface texture-rules {
    /// A block state a rule matches.
    record block-filter {
        /// `minecraft:glass`, ...
        id: string,
        /// Properties the state must have, all of them (`axis`=`y`).
        properties: list<tuple<string, string>>,
    }
    /// When a neighbour counts as connected.
    enum connect {
        /// The same block (id), whatever its properties.
        block,
        /// The same state (id and every property).
        state,
        /// A neighbour that shows the same picture on the same side.
        tile,
    }
    /// How the face's tile is chosen.
    enum method {
        /// By the pattern of connected neighbours (`pattern-tiles`).
        pattern,
        /// By the face's position, weighted (`tiles` and `weights`).
        random,
        /// By the block's place along the face (`grid-tiles`).
        position,
        /// Four quarters of the face, each with its own table
        /// (`quarter-tiles`).
        quarters,
    }
    record rule {
        /// States the rule matches.
        blocks: list<block-filter>,
        /// Pictures the rule matches: `minecraft:block/glass`. A face that
        /// shows one of them uses the rule too.
        sprites: list<string>,
        /// Faces the rule matches, a mask: north 1, east 2, south 4, west 8,
        /// up 16, down 32.
        faces: u32,
        connect: connect,
        method: method,
        /// The pictures the rule may draw: names of `upload-sprite` (the
        /// game adds the mod's id), or a picture of the game's own
        /// (`minecraft:block/glass`).
        tiles: list<string>,
        /// `pattern`: the tile of each of the 256 patterns, an index in
        /// `tiles`; 4294967295 for none. Bits: 1 the neighbour on the left of
        /// the face, 2 lower left, 4 below, 8 lower right, 16 right, 32
        /// upper right, 64 above, 128 upper left. Left and right follow the
        /// picture's `u`, below follows its `v`.
        pattern-tiles: list<u32>,
        /// `quarters`: eight tiles for each quarter (upper left, upper
        /// right, lower left, lower right), indexed by 1 side neighbour
        /// connected (the one on the quarter's horizontal side), 2 vertical
        /// side, 4 diagonal.
        quarter-tiles: list<u32>,
        /// `position`: the tile of each cell of a `width` by `height` grid,
        /// row by row; the cell is `(v mod height) * width + (u mod width)`
        /// for the block's `u` along the face (to the right) and `v` (down).
        grid-tiles: list<u32>,
        width: u32,
        height: u32,
        /// `random`: each tile's weight; a missing one weighs 1.
        weights: list<u32>,
    }
    /// Adds a picture (PNG) to the block atlas under `name`; the same name
    /// replaces the old picture. The game rebuilds the atlas and meshes the
    /// world again. At most 512 pictures a mod, 1 MiB each.
    upload-sprite: func(name: string, png: list<u8>) -> result<_, string>;
    /// Adds a rule; rules are tried in the order they were added (the mods'
    /// in turn), and the first that gives a tile wins. At most 512 a mod.
    register-rule: func(rule: rule) -> result<_, string>;
    /// Removes every rule and picture of this mod.
    clear-rules: func();
}

/// Capability `lighting`: light sources the mod gives the world, like a
/// torch in the player's hand (API 0.1.13). Nothing is relit: the game keeps
/// the sources nearest the camera and the shaders raise the block light of
/// what they reach, one level less per block of distance, before the
/// lightmap.
interface lighting {
    record light {
        /// Where the source is, in the world.
        x: f64,
        y: f64,
        z: f64,
        /// 0 to 15, as block light.
        level: u8,
    }
    /// The mod's light sources; the game keeps them until the mod sets
    /// another list (an empty one removes its light) and drops them when
    /// the mod stops. Up to 256 sources; the game draws the 16 nearest
    /// the camera that can still light something in sight. Call it from
    /// `frame` or `tick`.
    set-lights: func(lights: list<light>);
    /// The light a block gives off (`lightEmission`), 0 to 15; 0 for an
    /// id that is not a block or an unknown one.
    get-block-emission: func(id: string) -> u8;
}

/// Capability `debug`: lines the mod adds to the debug screen (F3) (API
/// 0.1.11).
interface debug {
    /// The mod's lines, in a group of their own; an empty list removes the
    /// group. At most 16 lines of 256 characters.
    set-lines: func(lines: list<string>);
}

/// What the game calls. Only the hooks `init` asks for are ever called.
interface events {
    record registration {
        /// Chat commands, without the slash. A name vanilla already uses is
        /// refused (vanilla's command runs).
        commands: list<string>,
        /// Call `tick` every game tick (20 per second while playing).
        tick: bool,
        /// Call `frame` every rendered frame. Budget: 0.1 ms.
        frame: bool,
        /// Call `chat` for each chat line the player receives.
        chat: bool,
    }
    /// Once, after loading. An error keeps the mod off and is shown.
    init: func() -> result<registration, string>;
    /// Each game tick while in a world, with the game's tick counter.
    tick: func(tick: u64);
    /// Each rendered frame, with the seconds since the last one.
    frame: func(seconds: f32);
    /// `/name args`: ok(some(text)) is shown as feedback, err(text) in red.
    command: func(name: string, args: string) -> result<option<string>, string>;
    /// Each chat line the player receives, as plain text.
    chat: func(text: string);
}

/// Capability `exchange` (API 0.1.27): data one mod publishes and others
/// read, so mods can work together (an enchantment mod gives its
/// descriptions to a recipe browser). The data lives while the game runs.
interface exchange {
    /// Publishes bytes under a key of this mod (`[a-z0-9_.-]`, up to 64
    /// characters), replacing the earlier ones. Up to 64 keys of 1 MiB.
    publish: func(key: string, data: list<u8>) -> result<_, string>;
    /// Removes a key of this mod.
    withdraw: func(key: string);
    /// The bytes another mod (or this one) published under the key since the
    /// game started; none when there are none.
    read: func(mod-id: string, key: string) -> option<list<u8>>;
    /// The keys a mod published, sorted.
    list-keys: func(mod-id: string) -> list<string>;
}

world horizon-mod {
    import log;
    import game;
    import chat;
    import hud;
    import target;
    import inventory;
    import hotbar;
    import keys;
    import storage;
    import screen;
    import items;
    import recipes;
    import weather;
    import settings;
    import particles;
    import atmosphere;
    import overlay;
    import %entity;
    import slots;
    import tooltip;
    import debug;
    import lighting;
    import chat-decorate;
    import players;
    import light-events;
    import audio;
    import input;
    import exchange;
    import resources;
    import texture-rules;
    import %world;
    export events;
}
